---
interface Props {
  target: string;
  label: string;
  class?: string;
}

const { target, label, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['press-copy-action', className]}
  data-copy-target={target}
  data-copy-label={label}
>
  <span class="press-copy-action__icon" aria-hidden="true">
    <svg
      class="press-copy-action__sheets"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="square"
      stroke-linejoin="miter"
      focusable="false"
    >
      <path d="M8 8h11v12H8z" />
      <path d="M5 16H3V4h11v2" />
    </svg>
    <svg
      class="press-copy-action__check"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      stroke-linejoin="miter"
      focusable="false"
    >
      <path pathLength="1" d="m5 12 4 4L19 6" />
    </svg>
  </span>
  <span data-copy-action-label>{label}</span>
</button>

<style>
  .press-copy-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.7rem;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-brand-blue);
    font-family: var(--font-label-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1.35;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 160ms ease-out;
  }

  .press-copy-action__icon {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: none;
    overflow: hidden;
    place-items: center;
    background: rgb(61 67 206 / 8%);
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out;
  }

  .press-copy-action__icon svg {
    position: absolute;
    width: 1rem;
    height: 1rem;
  }

  .press-copy-action__check {
    opacity: 0;
  }

  .press-copy-action__check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .press-copy-action:hover .press-copy-action__icon,
  .press-copy-action[data-copy-state='success'] .press-copy-action__icon {
    background: var(--color-brand-blue);
    color: white;
  }

  .press-copy-action[data-copy-state='success'] .press-copy-action__sheets {
    animation: press-copy-sheets-out 220ms cubic-bezier(0.4, 0, 1, 1) both;
  }

  .press-copy-action[data-copy-state='success'] .press-copy-action__check {
    animation: press-copy-check-in 320ms 120ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .press-copy-action[data-copy-state='success'] .press-copy-action__check path {
    animation: press-copy-check-draw 280ms 150ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .press-copy-action[data-copy-state='success'] > span:last-child {
    animation: press-copy-label-in 240ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .press-copy-action:hover > span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.18rem;
  }

  .press-copy-action[data-copy-state='error'] {
    color: var(--color-brand-night);
  }

  .press-copy-action[data-copy-state='error'] .press-copy-action__icon {
    background: var(--color-brand-orange);
    color: var(--color-brand-night);
  }

  .press-copy-action:focus-visible {
    outline: 2px solid var(--color-brand-orange);
    outline-offset: 4px;
  }

  @keyframes press-copy-sheets-out {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    100% {
      opacity: 0;
      transform: translate(0.22rem, 0.22rem) scale(0.78);
    }
  }

  @keyframes press-copy-check-in {
    0% {
      opacity: 0;
      transform: scale(0.72) rotate(-6deg);
    }

    100% {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @keyframes press-copy-check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes press-copy-label-in {
    0% {
      opacity: 0;
      transform: translateX(-0.25rem);
    }

    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .press-copy-action[data-copy-state='success'] .press-copy-action__sheets,
    .press-copy-action[data-copy-state='success'] .press-copy-action__check,
    .press-copy-action[data-copy-state='success'] .press-copy-action__check path,
    .press-copy-action[data-copy-state='success'] > span:last-child {
      animation: none;
    }

    .press-copy-action[data-copy-state='success'] .press-copy-action__sheets {
      opacity: 0;
    }

    .press-copy-action[data-copy-state='success'] .press-copy-action__check {
      opacity: 1;
    }

    .press-copy-action[data-copy-state='success'] .press-copy-action__check path {
      stroke-dashoffset: 0;
    }
  }
</style>
