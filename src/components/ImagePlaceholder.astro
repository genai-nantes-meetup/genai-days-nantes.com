---
import EventName from './EventName.astro';
import EVENT from '../content/event.json';

interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Image à venir',
  class: className = '',
} = Astro.props;
---

<div class:list={['image-placeholder', className]} role="img" aria-label={label}>
  <div class="image-placeholder__frame" aria-hidden="true">
    <span>VISUEL</span>
    <strong>{label}</strong>
    <small><EventName /> · {EVENT.year}</small>
  </div>
</div>

<style>
  .image-placeholder {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 8rem;
    place-items: center;
    overflow: hidden;
    background:
      linear-gradient(rgb(255 255 255 / 11%) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(90deg, rgb(255 255 255 / 11%) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(135deg, #10152e 0%, #263c8f 58%, #3d43ce 100%);
    color: #fff;
  }

  .image-placeholder::before,
  .image-placeholder::after {
    content: "";
    position: absolute;
    width: 140%;
    height: 1px;
    background: rgb(255 255 255 / 28%);
  }

  .image-placeholder::before {
    transform: rotate(24deg);
  }

  .image-placeholder::after {
    transform: rotate(-24deg);
  }

  .image-placeholder__frame {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(255 255 255 / 42%);
    background: rgb(8 12 30 / 34%);
    text-align: center;
  }

  .image-placeholder__frame span,
  .image-placeholder__frame small {
    font-family: var(--font-label-mono);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .image-placeholder__frame strong {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
