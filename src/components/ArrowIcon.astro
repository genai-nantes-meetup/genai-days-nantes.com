---
interface Props {
  direction?: 'right' | 'left' | 'up' | 'external';
  class?: string;
}

const { direction = 'right', class: className } = Astro.props;
---

<svg
  class:list={['arrow-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {direction === 'right' && <path d="M3 12h17M14 6l6 6-6 6" />}
  {direction === 'left' && <path d="M21 12H4M10 6l-6 6 6 6" />}
  {direction === 'up' && <path d="M12 21V4M6 10l6-6 6 6" />}
  {direction === 'external' && <path d="M6 18 18 6M9 6h9v9" />}
</svg>

<style>
  .arrow-icon {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }
</style>
