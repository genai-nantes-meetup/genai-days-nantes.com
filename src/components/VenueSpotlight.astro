---
import EditorialCta from './EditorialCta.astro';
import EditorialGrid from './EditorialGrid.astro';
import VenueMap from './VenueMap.astro';
import { EVENT, formatEventDateLabel } from '../lib/event';
import { getLocaleFromPath, localizePath } from '../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const copy = {
  fr: {
    title: 'Au bord de la Loire, au cœur de Nantes.',
    lede: `L’${EVENT.venue.shortName} accueille les conférences, les rencontres et les temps communs de la journée.`,
    illustrationAlt: `L’${EVENT.venue.shortName} à ${EVENT.venue.city}, illustré en bleu et orange`,
    dateLabel: 'Date',
    doorsLabel: 'Accueil',
    addressLabel: 'Adresse',
    practicalLink: 'Préparer ma venue',
    accessLabel: 'Accès au lieu',
    access: [
      { term: 'Transports', lines: ['Busway 5 · arrêt Pompidou', 'Bus 26 · terminus Hôtel de Région'] },
      { term: 'Parking', lines: ['Parking du parc de Beaulieu et voirie alentour · stationnement payant'] },
      { term: 'Entrée', lines: ['Rue de la Loire · portail côté œuvre de François Morellet'] },
    ],
  },
  en: {
    title: 'On the banks of the Loire, in the heart of Nantes.',
    lede: `The ${EVENT.venue.shortName} hosts the day’s talks, networking and joint sessions.`,
    illustrationAlt: `The ${EVENT.venue.shortName} in ${EVENT.venue.city}, illustrated in blue and orange`,
    dateLabel: 'Date',
    doorsLabel: 'Doors',
    addressLabel: 'Address',
    practicalLink: 'Plan my visit',
    accessLabel: 'Getting to the venue',
    access: [
      { term: 'Transit', lines: ['Busway 5 · Pompidou stop', 'Bus 26 · Hôtel de Région (last stop)'] },
      { term: 'Parking', lines: ['Parc de Beaulieu parking lot and nearby streets · paid parking'] },
      { term: 'Entrance', lines: ['Rue de la Loire · gate by the François Morellet artwork'] },
    ],
  },
}[locale];

const venueIllustration = '/images/hotel-region-banner-genai-days-web-optimized.webp';
---

<section id="lieu" class="venue-spotlight" aria-labelledby="venue-spotlight-title">
  <EditorialGrid />
  <div class="venue-spotlight__shell">
    <header class="venue-spotlight__copy">
      <h2 id="venue-spotlight-title" class="type-section-title">
        {copy.title}
      </h2>
      <p>
        {copy.lede}
      </p>
    </header>

    <div class="venue-spotlight__inner">
      <div class="venue-spotlight__media">
        <figure class="venue-spotlight__visual">
          <img
            src={venueIllustration}
            alt={copy.illustrationAlt}
            width="1774"
            height="886"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="venue-spotlight__card">

      <dl class="venue-spotlight__facts">
        <div>
          <dt>{copy.dateLabel}</dt>
          <dd>{formatEventDateLabel(locale)}</dd>
        </div>
        <div>
          <dt>{copy.doorsLabel}</dt>
          <dd>{EVENT.startTime}</dd>
        </div>
        <div>
          <dt>{copy.addressLabel}</dt>
          <dd>{EVENT.venue.address}<br />{EVENT.venue.postalCode} {EVENT.venue.city}</dd>
        </div>
      </dl>

        <div class="venue-spotlight__cta">
          <EditorialCta href={localizePath('/infos-pratiques', locale)}>{copy.practicalLink}</EditorialCta>
        </div>

        <div class="venue-spotlight__map-slot">
          <VenueMap />
        </div>

        <aside class="venue-spotlight__logistics" aria-label={copy.accessLabel}>
          <dl class="venue-spotlight__access">
            {copy.access.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>{item.lines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</dd>
              </div>
            ))}
          </dl>

        </aside>
      </div>
    </div>
  </div>
</section>


<style>
  .venue-spotlight {
    position: relative;
    padding: var(--space-section-compact) 0;
    background: var(--color-brand-cream);
    color: var(--color-brand-black);
  }

  .venue-spotlight__shell {
    position: relative;
    z-index: 3;
    display: grid;
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    margin-inline: auto;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .venue-spotlight__inner {
    display: grid;
    overflow: hidden;
    border: 1px solid rgb(from var(--color-brand-black) r g b / 16%);
    background: var(--color-brand-cream-deep);
  }

  .venue-spotlight__media {
    min-width: 0;
    background: var(--color-brand-night);
  }

  .venue-spotlight__visual {
    position: relative;
    height: 100%;
    min-height: clamp(15rem, 58vw, 22rem);
    margin: 0;
    background: var(--color-brand-night);
  }

  .venue-spotlight__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .venue-spotlight__card {
    display: grid;
    min-width: 0;
    align-content: space-between;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .venue-spotlight__copy {
    display: grid;
    max-width: 100%;
    justify-items: start;
    padding-inline: clamp(1.5rem, 2.5vw, 2rem);
    gap: 1rem;
    text-align: left;
  }

  .venue-spotlight__copy h2 {
    max-width: none;
  }

  .venue-spotlight__copy p {
    max-width: 62ch;
    color: rgb(from var(--color-brand-black) r g b / 72%);
    font-family: var(--font-sans);
    line-height: 1.6;
    text-wrap: balance;
  }

  .venue-spotlight__facts {
    display: grid;
    margin: 0;
    gap: 1.5rem;
  }

  .venue-spotlight__facts > div {
    display: grid;
    gap: 0.35rem;
  }

  .venue-spotlight__facts > div + div {
    border-top: 0;
  }

  .venue-spotlight__facts dt {
    color: rgb(from var(--color-brand-black) r g b / 58%);
    font-family: var(--font-nav);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .venue-spotlight__facts dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .venue-spotlight__cta,
  .venue-spotlight__logistics {
    display: grid;
    align-content: stretch;
    gap: 1rem;
  }

  .venue-spotlight__cta :global(.editorial-cta) {
    justify-self: start;
  }

  .venue-spotlight__access {
    display: grid;
    height: 100%;
    margin: 0;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .venue-spotlight__access > div {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }

  .venue-spotlight__access > div + div {
    padding-top: 1.25rem;
    border-top: 1px solid rgb(from var(--color-brand-black) r g b / 12%);
  }

  .venue-spotlight__access dt {
    color: rgb(from var(--color-brand-black) r g b / 58%);
    font-family: var(--font-nav);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .venue-spotlight__access dd {
    margin: 0;
    color: rgb(from var(--color-brand-black) r g b / 76%);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  @media (min-width: 52rem) {
    .venue-spotlight__inner {
      grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr);
    }

    .venue-spotlight__media {
      min-height: clamp(23rem, 26vw, 27rem);
    }

    .venue-spotlight__visual {
      min-height: 0;
    }

    .venue-spotlight__facts > div {
      grid-template-columns: 5rem minmax(0, 1fr);
      align-items: baseline;
      gap: 1rem;
    }

    .venue-spotlight__copy p {
      max-width: none;
      text-wrap: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .venue-spotlight__card {
      grid-template-columns: minmax(0, 1.45fr) minmax(14rem, 0.55fr);
      grid-template-areas:
        'facts facts'
        'cta cta'
        'map logistics';
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: 1.5rem;
    }

    .venue-spotlight__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-area: facts;
    }

    .venue-spotlight__facts > div {
      display: block;
      padding-inline: 0;
    }

    .venue-spotlight__facts > div + div {
      border-top: 0;
      padding-left: clamp(1rem, 2vw, 1.5rem);
      border-left: 1px solid rgb(from var(--color-brand-black) r g b / 12%);
    }

    .venue-spotlight__facts dd {
      margin-top: 0.45rem;
    }

    .venue-spotlight__cta {
      grid-area: cta;
    }

    .venue-spotlight__map-slot {
      grid-area: map;
    }

    .venue-spotlight__logistics {
      grid-area: logistics;
    }
  }

</style>
