---
import EditorialGrid from './EditorialGrid.astro';

interface Props {
  title: string;
  titleId: string;
  lede: string;
  image: string;
  imageWidth: number;
  imageHeight: number;
  imagePosition?: string;
}

const {
  title,
  titleId,
  lede,
  image,
  imageWidth,
  imageHeight,
  imagePosition = '50% 50%',
} = Astro.props;
const hasActions = Astro.slots.has('default');
---

<section class="directory-hero" aria-labelledby={titleId}>
  <figure class="directory-hero__visual" aria-hidden="true">
    <img
      src={image}
      alt=""
      width={imageWidth}
      height={imageHeight}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      style={`--directory-image-position: ${imagePosition};`}
    />
  </figure>
  <span class="directory-hero__shade" aria-hidden="true"></span>
  <EditorialGrid tone="paper" top={false} />

  <div class="directory-hero__inner">
    <div class="directory-hero__copy">
      <h1 id={titleId} class="type-page-title type-page-title--long">{title}</h1>
      <p class="type-page-lede">{lede}</p>
      {hasActions && <div class="directory-hero__actions"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .directory-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-night);
    color: var(--color-brand-cream);
    isolation: isolate;
  }

  .directory-hero__inner {
    position: relative;
    z-index: 3;
    display: grid;
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    min-height: clamp(17rem, 23vw, 21rem);
    margin-inline: auto;
  }

  .directory-hero__copy {
    position: relative;
    z-index: 3;
    display: grid;
    max-width: 38rem;
    align-content: center;
    padding: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.75rem);
    gap: clamp(0.65rem, 1vw, 0.9rem);
  }

  .directory-hero__copy .type-page-title {
    max-width: 14ch;
  }

  .directory-hero__copy .type-page-lede {
    max-width: 34rem;
    color: rgb(249 244 236 / 86%);
    font-size: 1rem;
    line-height: 1.65;
  }

  .directory-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.45rem;
  }

  .directory-hero__visual {
    position: absolute;
    z-index: 0;
    inset: 0 0 0 38%;
    margin: 0;
    pointer-events: none;
  }

  .directory-hero__visual::after {
    position: absolute;
    inset: 0;
    background: rgb(9 18 46 / 18%);
    content: '';
  }

  .directory-hero__visual img {
    width: 100%;
    height: 100%;
    filter: saturate(0.72) contrast(1.06);
    object-fit: cover;
    object-position: var(--directory-image-position);
  }

  .directory-hero__shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(9 18 46 / 100%) 0%,
        rgb(9 18 46 / 96%) 28%,
        rgb(9 18 46 / 78%) 48%,
        rgb(9 18 46 / 28%) 78%,
        rgb(9 18 46 / 16%) 100%
      ),
      linear-gradient(180deg, rgb(9 18 46 / 16%) 0%, transparent 52%, rgb(9 18 46 / 42%) 100%);
    pointer-events: none;
  }

  @media (max-width: 47.999rem) {
    .directory-hero__inner {
      min-height: clamp(18rem, 68vw, 21rem);
    }

    .directory-hero__copy {
      max-width: 34rem;
      padding: clamp(2.5rem, 11vw, 3.5rem) 0;
    }

    .directory-hero__visual {
      left: 28%;
    }

    .directory-hero__shade {
      background:
        linear-gradient(
          90deg,
          rgb(9 18 46 / 96%) 0%,
          rgb(9 18 46 / 88%) 48%,
          rgb(9 18 46 / 58%) 100%
        ),
        linear-gradient(180deg, rgb(9 18 46 / 38%) 0%, transparent 42%, rgb(9 18 46 / 62%) 100%);
    }
  }
</style>
