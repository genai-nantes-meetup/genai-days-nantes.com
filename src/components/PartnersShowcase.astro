---
import { getCollection } from 'astro:content';
import EditorialCta from './EditorialCta.astro';
import EditorialGrid from './EditorialGrid.astro';
import { EVENT } from '../lib/event';

const showcasePartners = (await getCollection('partners'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((partner) => {
    const logo = partner.data.monochromeLogo ?? partner.data.logo;
    const width = partner.data.monochromeLogoWidth ?? partner.data.logoWidth;
    const height = partner.data.monochromeLogoHeight ?? partner.data.logoHeight;
    const ratio = width / height;
    const format = ratio >= 2.8 ? 'wide' : ratio <= 1.8 ? 'compact' : 'standard';

    return {
      name: partner.data.name,
      website: partner.data.website,
      logo,
      width,
      height,
      format,
      coOrganizer: partner.data.coOrganizer,
    } as const;
  });

const coOrganizer = showcasePartners.find((partner) => partner.coOrganizer);
const scrollingPartners = showcasePartners.filter((partner) => !partner.coOrganizer);
const headingDescription = coOrganizer
  ? `La ${coOrganizer.name} co-organise cette édition et nous ouvre les portes de l’${EVENT.venue.shortName}.`
  : 'Entreprises, réseaux et acteurs du territoire réunis autour de cette première édition.';
---

<section
  id="partenaires"
  class="partner-showcase"
  data-partner-showcase
  aria-labelledby="partner-showcase-title"
>
  <EditorialGrid />

  <div class="partner-showcase__inner">
    <header class:list={['partner-showcase__heading', coOrganizer && 'partner-showcase__heading--with-coorganizer']}>
      <div class="partner-showcase__heading-copy">
        <h2 id="partner-showcase-title" class="type-section-title">Ils rendent la journée possible.</h2>
        <p>{headingDescription}</p>
      </div>
      {coOrganizer && (
        <a
          class="partner-showcase__coorganizer"
          href={coOrganizer.website}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visiter le site de ${coOrganizer.name}`}
          style={`--partner-logo: url("${coOrganizer.logo}");`}
        >
          <img
            src={coOrganizer.logo}
            alt={`Logo ${coOrganizer.name}`}
            width={coOrganizer.width}
            height={coOrganizer.height}
            loading="lazy"
            decoding="async"
          />
        </a>
      )}
    </header>

    <div class="partner-showcase__marquee" data-logo-marquee data-partner-layout="single-row" role="group" aria-label="Aperçu des partenaires">
      <button class="partner-showcase__toggle" type="button" aria-pressed="false" aria-label="Mettre en pause le défilement des logos" data-logo-marquee-toggle>
        <svg class="partner-showcase__pause-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
        <svg class="partner-showcase__play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
      </button>
      <div class="partner-showcase__viewport" tabindex="0" aria-label="Logos des partenaires, défilement horizontal">
        <div class="partner-showcase__track">
          {[false, true].map((duplicate) => (
            <ul
              class="partner-showcase__group"
              data-marquee-copy={duplicate ? 'duplicate' : 'primary'}
              aria-hidden={duplicate ? 'true' : undefined}
            >
              {scrollingPartners.map((partner) => (
                <li
                  class:list={['partner-showcase__logo', `partner-showcase__logo--${partner.format}`]}
                  data-partner-logo={duplicate ? undefined : partner.name}
                  style={`--partner-logo: url("${partner.logo}");`}
                >
                  <a
                    href={partner.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={duplicate ? undefined : `Visiter le site de ${partner.name}`}
                    tabindex={duplicate ? '-1' : undefined}
                  >
                    <img
                      src={partner.logo}
                      alt={duplicate ? '' : `Logo ${partner.name}`}
                      width={partner.width}
                      height={partner.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

    <div class="partner-showcase__cta">
      <EditorialCta href="/partenaires">Découvrir tous les partenaires</EditorialCta>
    </div>
  </div>
</section>

<script>
  import { initLogoMarquees } from '../scripts/logo-marquee';

  initLogoMarquees();
</script>

<style>
  .partner-showcase {
    --partner-ink: color-mix(in srgb, var(--color-brand-orange) 46%, var(--color-brand-black));
    position: relative;
    overflow: hidden;
    padding: var(--space-section-compact) 0 var(--space-section-close);
    background: var(--color-brand-cream);
    color: var(--color-brand-black);
    isolation: isolate;
  }

  .partner-showcase__inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    justify-items: center;
    margin-inline: auto;
  }

  .partner-showcase__heading {
    display: grid;
    width: 100%;
    max-width: 100%;
    justify-items: start;
    padding-inline: clamp(1.5rem, 2.5vw, 2rem);
    text-align: left;
  }

  .partner-showcase__heading-copy {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .partner-showcase__heading--with-coorganizer {
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .partner-showcase__heading h2 {
    max-width: 17ch;
    color: var(--color-brand-black);
  }

  .partner-showcase__heading p {
    max-width: 58ch;
    color: rgb(from var(--color-brand-black) r g b / 72%);
    font-family: var(--font-sans);
    line-height: 1.6;
    text-wrap: balance;
  }

  .partner-showcase__coorganizer {
    --partner-row-ink: color-mix(in srgb, var(--color-brand-orange) 52%, var(--color-brand-black));
    position: relative;
    display: grid;
    width: min(100%, 20rem);
    min-height: 8rem;
    place-items: center;
    justify-self: center;
  }

  .partner-showcase__coorganizer:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 4px;
  }

  .partner-showcase__coorganizer img {
    width: auto;
    max-width: 82%;
    height: auto;
    max-height: 7rem;
    object-fit: contain;
    opacity: 0;
  }

  .partner-showcase__coorganizer::before {
    position: absolute;
    width: 82%;
    height: 7rem;
    background: var(--partner-row-ink);
    content: '';
    -webkit-mask: var(--partner-logo) center / contain no-repeat;
    mask: var(--partner-logo) center / contain no-repeat;
    pointer-events: none;
    transition: background-color 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .partner-showcase__coorganizer:hover::before,
  .partner-showcase__coorganizer:focus-visible::before {
    background: var(--color-brand-blue);
    transform: scale(1.04);
  }

  .partner-showcase__marquee {
    --partner-gap: clamp(1.75rem, 3vw, 3rem);
    --marquee-fade: clamp(0.75rem, 2vw, 1.5rem);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    align-items: center;
    width: 100%;
    min-width: 0;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .partner-showcase__toggle {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-brand-black);
    opacity: 0.48;
    cursor: pointer;
  }

  .partner-showcase__toggle:hover,
  .partner-showcase__toggle:focus-visible {
    opacity: 1;
  }

  .partner-showcase__toggle:focus-visible,
  .partner-showcase__viewport:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .partner-showcase__toggle svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .partner-showcase__play-icon,
  .partner-showcase__marquee[data-paused='true'] .partner-showcase__pause-icon {
    display: none;
  }

  .partner-showcase__marquee[data-paused='true'] .partner-showcase__play-icon {
    display: block;
  }

  .partner-showcase__viewport {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--marquee-fade), #000 calc(100% - var(--marquee-fade)), transparent);
    mask-image: linear-gradient(to right, transparent, #000 var(--marquee-fade), #000 calc(100% - var(--marquee-fade)), transparent);
  }

  .partner-showcase__track {
    display: flex;
    width: max-content;
    animation: partner-marquee-scroll 38s linear infinite;
  }

  .partner-showcase__marquee[data-paused='true'] .partner-showcase__track,
  .partner-showcase__viewport:hover .partner-showcase__track,
  .partner-showcase__viewport:focus-within .partner-showcase__track {
    animation-play-state: paused;
  }

  .partner-showcase__group {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--partner-gap);
    padding-inline-end: var(--partner-gap);
    list-style: none;
  }

  .partner-showcase__group[data-marquee-copy='duplicate'] {
    pointer-events: none;
  }

  .partner-showcase__logo {
    position: relative;
    display: grid;
    width: 9.5rem;
    height: 5.75rem;
    flex: none;
    place-items: center;
  }

  .partner-showcase__logo--wide {
    width: 11rem;
  }

  .partner-showcase__logo--compact {
    width: 6.5rem;
  }

  .partner-showcase__logo > a {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
  }

  .partner-showcase__logo > a:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .partner-showcase__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }

  .partner-showcase__logo::before {
    position: absolute;
    inset: 0.75rem 0.35rem;
    background: var(--partner-ink);
    content: '';
    -webkit-mask: var(--partner-logo) center / contain no-repeat;
    mask: var(--partner-logo) center / contain no-repeat;
    pointer-events: none;
    transition: background-color 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .partner-showcase__logo--compact::before {
    inset-block: 0.45rem;
  }

  .partner-showcase__logo:has(a:hover)::before,
  .partner-showcase__logo:has(a:focus-visible)::before {
    background: var(--color-brand-blue);
    transform: scale(1.04);
  }

  .partner-showcase__cta {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @keyframes partner-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 47.999rem) {
    .partner-showcase__marquee {
      --partner-gap: 1.25rem;
      --marquee-fade: 0.75rem;
    }

    .partner-showcase__logo {
      width: 6.75rem;
      height: 4.25rem;
    }

    .partner-showcase__logo--wide {
      width: 8rem;
    }

    .partner-showcase__logo--compact {
      width: 4.75rem;
    }
  }

  @media (min-width: 48rem) {
    .partner-showcase__heading:not(.partner-showcase__heading--with-coorganizer) h2,
    .partner-showcase__heading:not(.partner-showcase__heading--with-coorganizer) p {
      max-width: none;
      text-wrap: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .partner-showcase__heading--with-coorganizer {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr);
      align-items: center;
      text-align: left;
    }

    .partner-showcase__heading--with-coorganizer .partner-showcase__heading-copy {
      justify-items: start;
    }

    .partner-showcase__heading--with-coorganizer h2 {
      max-width: none;
    }

    .partner-showcase__coorganizer {
      justify-self: end;
    }
  }

  @media (min-width: 75rem) {
    .partner-showcase__heading--with-coorganizer p {
      max-width: none;
      text-wrap: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-showcase__toggle {
      display: none;
    }

    .partner-showcase__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .partner-showcase__track {
      animation: none;
    }

    .partner-showcase__group[data-marquee-copy='duplicate'] {
      display: none;
    }

    .partner-showcase__logo::before,
    .partner-showcase__coorganizer::before {
      transition: none;
    }
  }
</style>
