---
/* Chemin sans geste vers « Ma journée » : la carte qui porte ce bouton est
 * annotée data-my-day-session, et src/scripts/my-day.ts fait le reste. Le nom
 * accessible reste stable, l'état passe par aria-pressed : le bouton est une
 * bascule, pas deux actions. */
interface Props {
  title: string;
  class?: string;
  variant?: 'default' | 'gutter';
}

const { title, class: className = '', variant = 'default' } = Astro.props;
---

<button
  class:list={['my-day-toggle', { 'my-day-toggle--gutter': variant === 'gutter' }, className]}
  type="button"
  data-my-day-toggle
  aria-pressed="false"
  aria-label={`Inclure « ${title} » dans ma journée`}
  title="Ajouter à ma journée"
>
  <span class="my-day-toggle__mark" aria-hidden="true"></span>
  {variant === 'default' && <span class="my-day-toggle__text" data-my-day-toggle-label>Ajouter à ma journée</span>}
</button>

<style>
  .my-day-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.7rem 0.42rem 0.55rem;
    border: 1px solid rgb(57 54 54 / 34%);
    background: var(--color-brand-white);
    color: var(--color-brand-black);
    font-family: var(--font-label-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .my-day-toggle__mark {
    display: inline-grid;
    width: 0.85rem;
    height: 0.85rem;
    place-items: center;
    border: 1px solid currentColor;
    transition: background 160ms ease;
  }

  .my-day-toggle__mark::after {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    background: currentColor;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 160ms ease, transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .my-day-toggle:hover,
  .my-day-toggle:focus-visible {
    border-color: var(--color-brand-blue);
    color: var(--color-brand-blue);
  }

  .my-day-toggle[aria-pressed='true'] {
    border-color: var(--color-brand-blue);
    background: var(--color-brand-blue);
    color: var(--color-brand-white);
  }

  .my-day-toggle[aria-pressed='true'] .my-day-toggle__mark::after {
    opacity: 1;
    transform: scale(1);
  }

  .my-day-toggle[aria-pressed='true']:hover,
  .my-day-toggle[aria-pressed='true']:focus-visible {
    background: var(--color-brand-night);
    border-color: var(--color-brand-night);
    color: var(--color-brand-white);
  }

  .my-day-toggle--gutter {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border-color: transparent;
    background: transparent;
    color: rgb(57 54 54 / 58%);
    justify-content: center;
  }

  .my-day-toggle--gutter .my-day-toggle__mark {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
  }

  .my-day-toggle--gutter .my-day-toggle__mark::after {
    width: auto;
    height: auto;
    background: transparent;
    content: '+';
    opacity: 1;
    transform: none;
  }

  .my-day-toggle--gutter:hover,
  .my-day-toggle--gutter:focus-visible,
  .my-day-toggle--gutter[aria-pressed='true'],
  .my-day-toggle--gutter[aria-pressed='true']:hover,
  .my-day-toggle--gutter[aria-pressed='true']:focus-visible {
    border-color: transparent;
    background: transparent;
    color: var(--color-brand-blue);
  }

  .my-day-toggle--gutter:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 2px;
  }

  .my-day-toggle--gutter[aria-pressed='true'] .my-day-toggle__mark {
    background: var(--color-brand-blue);
    color: var(--color-brand-white);
  }

  .my-day-toggle--gutter[aria-pressed='true'] .my-day-toggle__mark::after {
    content: '✓';
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .my-day-toggle,
    .my-day-toggle__mark,
    .my-day-toggle__mark::after {
      transition: none;
    }
  }
</style>
