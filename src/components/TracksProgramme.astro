---
import { getCollection } from 'astro:content';
import EditorialCta from './EditorialCta.astro';
import EditorialGrid from './EditorialGrid.astro';
import TrackMark from './TrackMark';
import { EVENT } from '../lib/event';
import { PROGRAMME_SLOTS } from '../lib/programme';

const tracks = await getCollection('tracks');
const sessions = await getCollection('sessions');
const decisionTrack = tracks.find((track) => track.id === 'decideurs');
const deliveryTrack = tracks.find((track) => track.id === 'tech');
const startupContest = sessions.find((session) => session.id === 'startup-contest');

if (!decisionTrack || !deliveryTrack) {
  throw new Error('Les deux parcours du programme doivent être définis.');
}

const afterworkStart = PROGRAMME_SLOTS.find((slot) => slot.kind === 'social')?.time ?? EVENT.endTime;
const conferenceCount = PROGRAMME_SLOTS.filter((slot) => slot.kind === 'conference').length * tracks.length;
---

<section id="programme" class="tracks-programme" aria-labelledby="tracks-programme-title">
  <EditorialGrid />

  <div class="tracks-programme__inner">
    <header class="tracks-programme__intro">
      <h2 id="tracks-programme-title" class="type-section-title">Un même terrain.<br />Deux parcours.</h2>
      <p class="tracks-programme__lede type-section-lede">
        Deux parcours en parallèle. Vous passez de l’un à l’autre entre deux sessions.
      </p>
    </header>

    <figure class="tracks-programme__visual">
      <img
        src="/images/affiche-decide-implemente-optimized.webp"
        alt="Deux voies, l’une bleue et l’autre orange, convergent vers un même horizon, entre boussole et rouages"
        width="2560"
        height="1072"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="tracks-programme__tracks">
      <article class="tracks-programme__track tracks-programme__track--decision">
        <h3><TrackMark track="decideurs" /></h3>
        <p class="tracks-programme__meta">{decisionTrack.data.formats.join(' · ')}</p>
        <ul>
          {decisionTrack.data.themes.map((theme) => <li>{theme}</li>)}
        </ul>
      </article>

      <article class="tracks-programme__track tracks-programme__track--delivery">
        <h3><a class="tracks-programme__track-link" href="/programme?parcours=tech#planning"><TrackMark track="tech" /></a></h3>
        <p class="tracks-programme__meta">{deliveryTrack.data.formats.join(' · ')}</p>
        <ul>
          {deliveryTrack.data.themes.map((theme) => <li>{theme}</li>)}
        </ul>
      </article>
    </div>

    <div class="tracks-programme__programme-link">
      <EditorialCta href="/programme">Voir le programme complet</EditorialCta>
    </div>

    <div class="tracks-programme__day">
      <header class="tracks-programme__day-heading">
        <h3>Le rythme de la journée.</h3>
      </header>

      <ol class="tracks-programme__timeline" aria-label="Les temps forts de la journée">
        <li>
          <h4>Conférences et keynotes.</h4>
          <p class="tracks-programme__time">
            <time datetime={EVENT.startTime}>{EVENT.startTime}</time><span aria-hidden="true"> → </span><time datetime={afterworkStart}>{afterworkStart}</time>
          </p>
          <p>{conferenceCount} conférences réparties sur les deux scènes. Les captations sont publiées après l’événement.</p>
        </li>
        <li>
          <h4>Startup Contest. Podcast.</h4>
          <p class="tracks-programme__time">En public</p>
          <p>Les startups montent sur scène à {startupContest?.data.startTime ?? '13:45'} côté Ceux qui décident, devant un jury d’entrepreneurs et de décideurs. Le podcast s’enregistre en fin de journée côté Ceux qui implémentent.</p>
        </li>
        <li>
          <h4>Apéro networking. DJ set.</h4>
          <p class="tracks-programme__time">
            <time datetime={afterworkStart}>{afterworkStart}</time><span aria-hidden="true"> → </span><time datetime={EVENT.endTime}>{EVENT.endTime}</time>
          </p>
          <p>Avec les intervenants, les partenaires et les participants. DJ set jusqu’à {EVENT.endTime}.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .tracks-programme {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-brand-cream);
    color: var(--color-brand-black);
  }

  .tracks-programme__inner {
    position: relative;
    z-index: 2;
    padding-top: clamp(2.25rem, 3.5vw, 3rem);
  }

  .tracks-programme__inner > * {
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    margin-inline: auto;
  }

  .tracks-programme__intro {
    display: grid;
    padding-inline: clamp(1.5rem, 2.5vw, 2rem);
    gap: 1rem;
  }

  .tracks-programme__intro h2 {
    max-width: 15ch;
  }

  .tracks-programme__lede {
    max-width: 36ch;
    color: rgb(57 54 54 / 76%);
    font-family: var(--font-sans);
  }

  /* L'illustration fait le pont : ses rails bleu et orange sortent du cadre
     et sont repris juste dessous par les filets d'encre des deux parcours. */
  .tracks-programme__visual {
    margin-block: clamp(1.5rem, 2.5vw, 2.25rem) 0;
  }

  .tracks-programme__visual img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }

  .tracks-programme__tracks {
    display: grid;
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
    padding-inline: clamp(1.5rem, 2.5vw, 2rem);
    gap: 2rem;
  }

  .tracks-programme__track {
    min-width: 0;
    padding-top: 1.15rem;
    border-top: 2px solid var(--color-brand-blue);
  }

  .tracks-programme__track--delivery {
    border-top-color: var(--color-brand-orange);
  }

  .tracks-programme__track h3 {
    display: flex;
    color: var(--color-brand-black);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  /* Le nom du parcours mène à son planning : soulignement discret au repos,
     repris par le filet d'encre du parcours au survol. Le TrackMark est un
     inline-flex, où la décoration du lien ne se propage pas : elle est posée
     sur le span de texte. */
  .tracks-programme__track-link {
    color: inherit;
    text-decoration: none;
  }

  .tracks-programme__track-link :global(.track-mark > span) {
    text-decoration: underline;
    text-decoration-color: rgb(57 54 54 / 28%);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 180ms ease;
  }

  .tracks-programme__track-link:hover :global(.track-mark > span),
  .tracks-programme__track-link:focus-visible :global(.track-mark > span) {
    text-decoration-color: var(--color-brand-blue);
    text-decoration-thickness: 2px;
  }

  .tracks-programme__track--delivery .tracks-programme__track-link:hover :global(.track-mark > span),
  .tracks-programme__track--delivery .tracks-programme__track-link:focus-visible :global(.track-mark > span) {
    text-decoration-color: var(--color-brand-orange);
  }

  .tracks-programme__track ul {
    display: grid;
    margin-top: 0.9rem;
    list-style: none;
  }

  .tracks-programme__track li {
    padding-block: 0.3rem;
    color: rgb(57 54 54 / 78%);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.4;
  }

  .tracks-programme__meta {
    margin-top: 0.6rem;
    color: rgb(57 54 54 / 76%);
    font-family: var(--font-label-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Le lien vers le programme ferme le diptyque des parcours, centré sur
     l'axe où les deux colonnes se rejoignent. */
  .tracks-programme__programme-link {
    display: flex;
    justify-content: center;
    margin-top: clamp(1rem, 1.5vw, 1.5rem);
  }

  .tracks-programme__day {
    display: grid;
    margin-top: clamp(3rem, 4.5vw, 4rem);
    padding-inline: clamp(1.5rem, 2.5vw, 2rem);
    padding-bottom: var(--space-section-close);
    gap: clamp(1.75rem, 2.5vw, 2.5rem);
  }

  .tracks-programme__day-heading {
    text-align: center;
  }

  .tracks-programme__day-heading h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .tracks-programme__timeline {
    display: grid;
    list-style: none;
  }

  .tracks-programme__timeline li {
    display: grid;
    justify-items: start;
    padding-block: 1rem 1.25rem;
    gap: 0.5rem;
    text-align: left;
  }

  .tracks-programme__timeline li + li {
    border-top: 1px solid rgb(57 54 54 / 11%);
  }

  .tracks-programme__time {
    color: rgb(57 54 54 / 76%);
    font-family: var(--font-label-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-ui);
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Le `text-wrap: balance` global ne couvre que h1 à h3 : les étapes étant
     passées en h4 pour rester sous leur titre de bloc, il est repris ici. */
  .tracks-programme__timeline h4 {
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }

  .tracks-programme__timeline li > p:last-child {
    max-width: 39ch;
    color: rgb(57 54 54 / 78%);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  @media (max-width: 47.999rem) {
    /* Sur mobile, le panorama garde un léger débord centré pour rester lisible.
       Le parent est répété pour battre la règle conteneur `__inner > *`. */
    .tracks-programme__inner > .tracks-programme__visual {
      width: min(35rem, 118vw);
      margin-inline: calc((100vw - min(35rem, 118vw)) / 2);
    }
  }

  @media (min-width: 48rem) {
    .tracks-programme__intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      align-items: end;
      gap: 2rem clamp(2rem, 6vw, 6rem);
    }

    .tracks-programme__lede {
      justify-self: end;
    }

    .tracks-programme__inner > .tracks-programme__visual {
      width: min(calc(100% - 2 * var(--layout-gutter)), 52rem);
    }

    .tracks-programme__tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 7vw, 6rem);
    }

    .tracks-programme__track--decision {
      text-align: right;
    }

    .tracks-programme__track--decision h3 {
      justify-content: flex-end;
    }
  }

  @media (min-width: 64rem) {
    .tracks-programme__timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 5vw, 4rem);
    }

    .tracks-programme__timeline li {
      align-content: start;
      padding: 0.25rem 0 0.5rem;
    }

    .tracks-programme__timeline li + li {
      border-top: 0;
    }

    .tracks-programme__timeline li:nth-child(2) {
      justify-items: center;
      text-align: center;
    }

    .tracks-programme__timeline li:nth-child(3) {
      justify-items: end;
      text-align: right;
    }
  }

  @media (max-width: 39.999rem) {
    .tracks-programme__inner {
      padding-top: 2.25rem;
    }
  }
</style>
