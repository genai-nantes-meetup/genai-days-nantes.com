---
import { getCollection } from 'astro:content';
import BrandText from '../../components/BrandText.astro';
import EventName from '../../components/EventName.astro';
import StickerRewardLayout from '../../layouts/StickerRewardLayout.astro';
import { EVENT, EVENT_URL, formatEventDateLabel, formatEventDateShort } from '../../lib/event';
import { getLocaleFromPath, localizePath } from '../../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const sessions = await getCollection('sessions');
const speakers = await getCollection('speakers');
const requiredLabelIds = [
  'landing-day-manifesto',
  ...speakers.map((speaker) => `speaker-${speaker.id}`),
  ...sessions.map((session) => `session-${session.id}`),
];

const shareRendezVous = {
  fr: `le ${formatEventDateLabel()} à ${EVENT.venue.city}`,
  en: `on ${formatEventDateLabel('en')} in ${EVENT.venue.city}`,
}[locale];
const copy = {
  fr: {
    title: 'Félicitations · GenAI Days',
    description: `Tu as complété l’easter egg GenAI Days. Rendez-vous ${shareRendezVous} pour récupérer ta récompense.`,
    step: 'Récompense · 02/02',
    eyebrow: 'MISSION ACCOMPLIE · DOSSIER CLASSÉ',
    ticketLabel: 'Récompense validée',
    statusLabel: 'STATUT',
    statusValue: 'GAGNANT·E',
    dateLabel: 'RENDEZ-VOUS',
    shareKicker: 'À TOI DE LANCER LE DÉFI',
    shareTitle: 'Partage ta découverte sans révéler le secret.',
    shareIntro: 'Ce message donne juste assez d’indices pour donner envie aux autres d’explorer le site à leur tour.',
    postPreviewLabel: 'Aperçu du post à partager',
    postLines: [
      'J’ai trouvé l’easter egg caché sur le site de GENAI DAYS 👀',
      'Je garde le secret, mais le défi est lancé.',
      'Explorez le site, ouvrez l’œil et dites-moi si vous le trouvez à votre tour.',
      `Rendez-vous ${shareRendezVous}. #GenAIDays`,
    ],
    shareOnLinkedIn: 'Partager sur LinkedIn',
    shareOnX: 'Partager sur X',
  },
  en: {
    title: 'Congratulations · GenAI Days',
    description: `You completed the GenAI Days easter egg. See you ${shareRendezVous} to collect your reward.`,
    step: 'Reward · 02/02',
    eyebrow: 'MISSION ACCOMPLISHED · CASE CLOSED',
    ticketLabel: 'Reward confirmed',
    statusLabel: 'STATUS',
    statusValue: 'WINNER',
    dateLabel: 'DATE',
    shareKicker: 'YOUR TURN TO CHALLENGE OTHERS',
    shareTitle: 'Share your find without giving away the secret.',
    shareIntro: 'This message gives just enough hints to make others want to explore the site themselves.',
    postPreviewLabel: 'Preview of the post to share',
    postLines: [
      'I found the easter egg hidden on the GENAI DAYS website 👀',
      'I’m keeping the secret, but the challenge is on.',
      'Explore the site, keep your eyes open and tell me if you find it too.',
      `See you ${shareRendezVous}. #GenAIDays`,
    ],
    shareOnLinkedIn: 'Share on LinkedIn',
    shareOnX: 'Share on X',
  },
}[locale];
/* Le post est composé une seule fois : l'aperçu et le texte réellement
 * partagé par le script doivent dire exactement la même chose. Depuis la
 * version anglaise, il renvoie vers l'accueil anglais. */
const shareText = copy.postLines.join('\n\n');
const shareUrl = locale === 'fr' ? EVENT_URL : new URL(localizePath('/', locale), EVENT_URL).href;
---

<StickerRewardLayout
  title={copy.title}
  description={copy.description}
  step={copy.step}
>
  <section
    class="reward-success"
    data-reward-success-page
    data-required-labels={JSON.stringify(requiredLabelIds)}
    data-share-text={shareText}
    data-share-url={shareUrl}
    hidden
  >
    <div class="reward-success__message">
      <p class="reward-success__eyebrow">{copy.eyebrow}</p>
      <h1>
        {locale === 'en' ? (
          <>Congratulations, <span data-reward-first-name>detective</span>!</>
        ) : (
          <>Félicitations, <span data-reward-first-name>toi</span>&nbsp;!</>
        )}
      </h1>
      <p class="reward-success__lead">
        {locale === 'en' ? (
          <>
            You completed the sticker easter egg. See you {shareRendezVous} to pick up
            your special gift from the <EventName /> team.
          </>
        ) : (
          <>
            Tu as complété l’easter egg des stickers. Rendez-vous {shareRendezVous} pour récupérer
            ton cadeau spécial auprès de l’équipe <EventName />.
          </>
        )}
      </p>
      <div class="reward-success__ticket" aria-label={copy.ticketLabel}>
        <div>
          <span>{copy.statusLabel}</span>
          <strong>{copy.statusValue}</strong>
        </div>
        <div>
          <span>{copy.dateLabel}</span>
          <strong>{formatEventDateShort()}</strong>
        </div>
        <b aria-hidden="true">{requiredLabelIds.length}/{requiredLabelIds.length}</b>
      </div>
    </div>

    <aside class="reward-success__share">
      <div class="reward-success__share-intro">
        <p>{copy.shareKicker}</p>
        <h2>{copy.shareTitle}</h2>
        <p>
          {copy.shareIntro}
        </p>
      </div>

      <article class="reward-success__post" aria-label={copy.postPreviewLabel}>
        <header>
          <span class="reward-success__avatar" aria-hidden="true">G</span>
          <div>
            <strong><EventName /></strong>
            <span>@GenAIDays</span>
          </div>
          <b aria-hidden="true">𝕏</b>
        </header>
        <div class="reward-success__post-copy" data-share-copy>
          {copy.postLines.map((line) => <p><BrandText text={line} /></p>)}
        </div>
        <footer>
          <span>{new URL(EVENT_URL).hostname}</span>
          <span>{formatEventDateLabel(locale)}</span>
        </footer>
      </article>

      <div class="reward-success__share-actions">
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          data-share-linkedin
        >
          {copy.shareOnLinkedIn}
        </a>
        <a
          href="https://twitter.com/intent/tweet"
          target="_blank"
          rel="noopener noreferrer"
          data-share-x
        >
          {copy.shareOnX}
        </a>
      </div>
      <p class="reward-success__share-status" data-share-status role="status" aria-live="polite"></p>
    </aside>
  </section>

  <noscript>
    <div class="reward-success__noscript">
      {locale === 'en' ? (
        <>JavaScript must be enabled to check your reward. <a href={localizePath('/', locale)}>Back to home</a></>
      ) : (
        <>JavaScript doit être activé pour vérifier ta récompense. <a href="/">Retour à l’accueil</a></>
      )}
    </div>
  </noscript>
</StickerRewardLayout>

<script>
  import { getDocumentLocale, localizePath } from '../../lib/i18n';
  import {
    getRewardRegistration,
    hasCollectedEvery,
  } from '../../lib/label-collection';

  const messages = {
    fr: {
      copied: 'Texte copié. Il ne reste plus qu’à le coller dans ton post LinkedIn.',
      previewReady: 'Le post est prêt dans l’aperçu juste au-dessus.',
    },
    en: {
      copied: 'Text copied. All that’s left is to paste it into your LinkedIn post.',
      previewReady: 'The post is ready in the preview just above.',
    },
  };

  const page = document.querySelector<HTMLElement>('[data-reward-success-page]');

  if (page) {
    const locale = getDocumentLocale();
    const copy = messages[locale];
    const requiredLabelIds = JSON.parse(page.dataset.requiredLabels || '[]') as string[];
    const registration = getRewardRegistration();

    /* L'inscription prime sur l'état du classeur : une étiquette peut être
     * reprise du classeur pour être recollée dans la page après coup, ce qui
     * rend la collection incomplète. Une récompense déjà enregistrée reste
     * acquise, sa page ne doit pas se refermer sur son gagnant. */
    if (registration) {
      const firstName = page.querySelector<HTMLElement>('[data-reward-first-name]');
      if (firstName) firstName.textContent = registration.firstName;
      page.hidden = false;
    } else if (!hasCollectedEvery(requiredLabelIds)) {
      window.location.replace(localizePath('/', locale));
    } else {
      window.location.replace(localizePath('/stickers/recompense', locale));
    }

    const postText = page.dataset.shareText || '';
    const shareUrl = page.dataset.shareUrl || '';
    const shareStatus = page.querySelector<HTMLElement>('[data-share-status]');
    const xLink = page.querySelector<HTMLAnchorElement>('[data-share-x]');
    const linkedinLink = page.querySelector<HTMLAnchorElement>('[data-share-linkedin]');

    if (xLink) {
      xLink.href =
        `https://twitter.com/intent/tweet?text=${encodeURIComponent(postText)}&url=${encodeURIComponent(shareUrl)}`;
    }

    linkedinLink?.addEventListener('click', () => {
      navigator.clipboard?.writeText(`${postText}\n\n${shareUrl}`).then(() => {
        if (shareStatus) {
          shareStatus.textContent = copy.copied;
        }
      }).catch(() => {
        if (shareStatus) {
          shareStatus.textContent = copy.previewReady;
        }
      });
    });
  }
</script>

<style>
  .reward-success {
    display: grid;
    width: min(72rem, 100%);
    grid-template-columns: minmax(0, 0.84fr) minmax(22rem, 1.16fr);
    gap: clamp(1.8rem, 6vw, 5.5rem);
    align-items: center;
  }

  .reward-success[hidden] {
    display: none;
  }

  .reward-success__eyebrow,
  .reward-success__share-intro > p:first-child {
    font-family: var(--font-label-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .reward-success__message h1 {
    max-width: 11ch;
    margin-top: 0.85rem;
    font-size: clamp(3.2rem, 8vw, 7rem);
    line-height: 0.82;
    text-wrap: balance;
  }

  .reward-success__lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 82%);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.5;
  }

  .reward-success__ticket {
    position: relative;
    display: grid;
    max-width: 34rem;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.6rem;
    padding: 1.1rem 4.6rem 1.1rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 34%);
    background: rgb(8 12 30 / 34%);
  }

  .reward-success__ticket div {
    display: grid;
    gap: 0.28rem;
  }

  .reward-success__ticket span {
    color: rgb(255 255 255 / 58%);
    font-family: var(--font-label-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .reward-success__ticket strong {
    font-size: 0.88rem;
  }

  .reward-success__ticket > b {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    width: 3.7rem;
    height: 100%;
    place-items: center;
    border-left: 1px dashed rgb(255 255 255 / 38%);
    font-family: var(--font-label-mono);
    font-size: 0.72rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .reward-success__share {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid rgb(255 255 255 / 22%);
    background: rgb(8 12 30 / 26%);
  }

  .reward-success__share-intro h2 {
    max-width: 16ch;
    margin-top: 0.55rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.94;
    text-wrap: balance;
  }

  .reward-success__share-intro > p:last-child {
    max-width: 36rem;
    margin-top: 0.8rem;
    color: rgb(255 255 255 / 70%);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .reward-success__post {
    margin-top: 1.25rem;
    overflow: hidden;
    border: 1px solid rgb(13 13 18 / 20%);
    border-radius: 0.9rem;
    background: #fff;
    box-shadow: 0.55rem 0.7rem 0 rgb(8 12 30 / 20%);
    color: #101014;
  }

  .reward-success__post header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1rem 0;
  }

  .reward-success__avatar {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    background: #3d43ce;
    color: #fff;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 800;
  }

  .reward-success__post header div {
    display: grid;
    min-width: 0;
  }

  .reward-success__post header div span {
    color: rgb(13 13 18 / 55%);
    font-size: 0.78rem;
  }

  .reward-success__post header > b {
    margin-left: auto;
    font-size: 1.25rem;
  }

  .reward-success__post-copy {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
    font-size: clamp(0.92rem, 2vw, 1.06rem);
    line-height: 1.35;
  }

  .reward-success__post footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid rgb(13 13 18 / 12%);
    color: rgb(13 13 18 / 58%);
    font-size: 0.72rem;
  }

  .reward-success__share-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .reward-success__share-actions a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 0.85rem;
    border: 2px solid #fff;
    border-radius: 0.25rem;
    color: #fff;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .reward-success__share-actions a:first-child {
    border-color: #fff;
    background: #fff;
    color: #22357d;
  }

  .reward-success__share-actions a:hover,
  .reward-success__share-actions a:focus-visible {
    opacity: 0.82;
  }

  .reward-success__share-status {
    min-height: 1.25rem;
    margin-top: 0.75rem;
    color: rgb(255 255 255 / 72%);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .reward-success__noscript {
    max-width: 34rem;
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 32%);
    background: rgb(8 12 30 / 42%);
    text-align: center;
  }

  .reward-success__noscript a {
    color: #fff;
  }

  @media (max-width: 54rem) {
    .reward-success {
      grid-template-columns: 1fr;
    }

    .reward-success__message h1 {
      max-width: 13ch;
    }
  }

  @media (max-width: 30rem) {
    .reward-success__share {
      padding: 1rem;
    }

    .reward-success__share-actions {
      grid-template-columns: 1fr;
    }

    .reward-success__post footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
