---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroAffiche from '../components/HeroAffiche.astro';
import LandingStory from '../components/LandingStory.astro';
import LabelArchive from '../components/LabelArchive.astro';
import { CTA_LINKS } from '../lib/cta-links';
import { buildEventJsonLd, EVENT } from '../lib/event';
import { getLocaleFromPath, localizePath } from '../lib/i18n';
import { sortSpeakersByProminence } from '../lib/speakers';

const locale = getLocaleFromPath(Astro.url.pathname);
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const pageUrl = new URL(localizePath('/', locale), siteUrl).href;
const coOrganizer = (await getCollection('partners')).find((partner) => partner.data.coOrganizer);
const coOrganizerName = coOrganizer?.data.name;
const copy = {
  fr: {
    pageTitle: `GENAI DAYS ${EVENT.year} · Conférence IA générative à ${EVENT.venue.city}${coOrganizerName ? ` avec le soutien de la ${coOrganizerName}` : ''}`,
    pageDescription: `Une journée-conférence sur l’IA générative à ${EVENT.venue.city} pour décideurs et équipes techniques : retours terrain, deux parcours et Startup Contest.${coOrganizerName ? ` Avec le soutien de la ${coOrganizerName}, qui accueille la journée à l’${EVENT.venue.shortName}.` : ''}`,
  },
  en: {
    pageTitle: `GENAI DAYS ${EVENT.year} · Generative AI conference in ${EVENT.venue.city}${coOrganizerName ? ` with support from the ${coOrganizerName}` : ''}`,
    pageDescription: `A one-day generative AI conference in ${EVENT.venue.city} for decision-makers and tech teams: real-world case studies, two tracks and a Startup Contest.${coOrganizerName ? ` With support from the ${coOrganizerName}, which hosts the day at the ${EVENT.venue.shortName}.` : ''} Talks are delivered in French.`,
  },
}[locale];
const speakers = sortSpeakersByProminence(await getCollection('speakers'));
const eventJsonLd = {
  ...(await buildEventJsonLd(siteUrl, CTA_LINKS.tickets, locale)),
  description: copy.pageDescription,
  /* L'URL suit la langue de la page, les @id restent communs aux deux versions. */
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  performer: speakers.map((speaker) => {
    const speakerUrl = new URL(localizePath(`/speakers/${speaker.id}`, locale), siteUrl).href;

    return {
      '@type': 'Person',
      '@id': `${speakerUrl}#person`,
      name: speaker.data.name,
      url: speakerUrl,
    };
  }),
};
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organizer`,
  name: EVENT.organizer.name,
  url: siteUrl,
  event: { '@id': `${siteUrl}#event` },
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: EVENT.name.toUpperCase(),
  alternateName: 'GenAI Days Nantes',
  url: pageUrl,
  inLanguage: locale,
  publisher: { '@id': `${siteUrl}#organizer` },
};
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  structuredData={[eventJsonLd, organizationJsonLd, websiteJsonLd]}
>
  <Header immersive />
  <main>
    <HeroAffiche />
    <LandingStory />
  </main>
  <Footer grid />
  <LabelArchive />
  <script>
    import { initLabelEasterEgg } from '../scripts/label-easter-egg';
    import { initPosterTrame } from '../scripts/poster-trame';

    initLabelEasterEgg();
    initPosterTrame();
  </script>
</BaseLayout>
