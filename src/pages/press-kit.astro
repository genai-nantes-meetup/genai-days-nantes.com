---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import EventName from "../components/EventName.astro";
import DirectoryHero from "../components/DirectoryHero.astro";
import EditorialGrid from "../components/EditorialGrid.astro";
import DownloadIcon from "../components/DownloadIcon.astro";
import PressContactAction from "../components/PressContactAction.astro";
import PressCopyAction from "../components/PressCopyAction.astro";
import PressDownloadAction from "../components/PressDownloadAction.astro";
import TrackMark from "../components/TrackMark";
import { formatEventDateLabel } from "../lib/event";
import { getLocaleFromPath, localizePath } from "../lib/i18n";
import { getLocalizedCollection } from "../lib/localized-content";
import EVENT from "../content/event.json";
import PRICING from "../content/pricing.json";
import PRESS from "../content/press.json";

const locale = getLocaleFromPath(Astro.url.pathname);

const partners = await getCollection("partners");
// Le drapeau `coOrganizer` met en avant la Région, qui soutient l’événement
// et l’accueille à l’Hôtel de Région : elle ne le co-organise pas.
const supporter = partners.find((partner) => partner.data.coOrganizer)?.data;
// Les sessions restent en français : la page n’en lit que des données
// communes aux deux langues, et le nom propre du podcast, que le titre
// anglais pourrait reformuler.
const sessions = await getCollection("sessions");
const speakers = await getLocalizedCollection("speakers", locale);
const openingKeynote = sessions.find((session) => session.data.format === "keynote");
const keynoteSpeaker = speakers.find(
  (speaker) => speaker.id === openingKeynote?.data.speakerSlugs[0],
)?.data;
const podcast = sessions.find((session) => session.data.format === "podcast");
const podcastName = podcast?.data.title.replace(/^Podcast\s+/, "");
const illustrationCount = sessions.filter((session) => session.data.illustration?.src).length;

const pressTeam = await getLocalizedCollection("team", locale);
const teamMember = (id: string) => {
  const member = pressTeam.find((entry) => entry.id === id);
  if (!member) throw new Error(`Membre de l’équipe introuvable : ${id}`);
  return member.data;
};
const maxime = teamMember("maxime-pitussi");
const samuel = teamMember("samuel-berthe");
const regionSpokesperson = PRESS.regionSpokesperson;
const regionSpokespersonCopy = locale === "en" ? regionSpokesperson.en : regionSpokesperson;

const pressTeamCount = pressTeam.length;
// README.pdf, visuel officiel, affiche, wordmark et symbole, plus les dossiers
// générés par scripts/build-press-kit.py.
const pressKitFileCount = 5 + illustrationCount + pressTeamCount;
const eventDate = formatEventDateLabel(locale);

const copy = {
  fr: {
    pageTitle: `Espace presse ${EVENT.year} · GENAI DAYS`,
    pageDescription: `Dossier de presse GENAI DAYS ${EVENT.year} à ${EVENT.venue.city} : faits clés, deux parcours, programme, visuel officiel, ${illustrationCount} illustrations des conférences, ${pressTeamCount} portraits de l’équipe et contact presse.`,
    title: "Espace presse",
    lede: `Textes, faits et visuels prêts à publier pour couvrir l’édition ${EVENT.year} à ${EVENT.venue.city}.`,
    downloadKit: "Télécharger le kit presse",
    heroDownloadMeta: "ZIP · PDF, visuels, illustrations et portraits",
    pressContact: "Contact presse",
    summaryTitle: "En bref.",
    summaryMeta: "Présentation prête à publier",
    copySummary: "Copier la présentation",
    factSheetTitle: "Fiche factuelle.",
    practicalDetails: [
      { label: "Date", value: eventDate },
      { label: "Horaires", value: `${EVENT.startTime} à ${EVENT.endTime}` },
      { label: "Lieu", value: EVENT.venue.name },
      {
        label: "Adresse",
        value: `${EVENT.venue.address}, ${EVENT.venue.postalCode} ${EVENT.venue.city}`,
      },
      { label: "Organisation", value: `Association ${EVENT.organizer.name}` },
      ...(supporter ? [{ label: "Soutien", value: supporter.name }] : []),
      { label: "Jauge", value: `${PRICING.capacity} participants` },
      {
        label: "Format",
        value: "Conférences, retours d’expérience et temps de rencontre",
      },
      { label: "Langue", value: "Français" },
    ],
    factSeparator: " : ",
    copyFacts: "Copier les informations clés",
    anglesTitle: "Trois angles pour raconter l’événement.",
    anglesLede:
      "Des sujets directement exploitables pour relier les enjeux de direction aux réalités d’implémentation.",
    editorialAngles: [
      {
        title: "Décider face à l’IA.",
        description:
          "Coûts, gouvernance, souveraineté, conformité et retour sur investissement.",
      },
      {
        title: "Passer des prototypes à la production.",
        description: "Architectures, agents, évaluation, données et observabilité.",
      },
      {
        title: "Partager ce que le terrain a appris.",
        description:
          "Des choix documentés, des méthodes concrètes et des retours d’expérience.",
      },
    ],
    tracksLabel: "Deux parcours complémentaires",
    programmeCta: "Voir le programme complet",
    resourcesTitle: "À télécharger.",
    resourcesLede:
      "Les fichiers essentiels, leurs formats et les crédits à conserver lors de la publication.",
    packageTitle: "Le kit presse complet.",
    packageText: `Dossier PDF avec programme, intervenants et partenaires, visuel officiel, wordmark et symbole vectoriels, ${illustrationCount} illustrations des conférences et ${pressTeamCount} portraits de l’équipe organisatrice.`,
    packageMeta: `ZIP · ${pressKitFileCount} fichiers`,
    download: "Télécharger",
    coverAlt: `Visuel officiel de l’édition ${EVENT.year}`,
    coverTitle: `Visuel officiel ${EVENT.year}`,
    coverFileName: `genai-days-${EVENT.year}-visuel-officiel.webp`,
    coverDownloadLabel: `Télécharger le visuel officiel ${EVENT.year}`,
    posterAlt: `Affiche officielle ${EVENT.year} avec titre, date et lieu`,
    posterTitle: `Affiche officielle ${EVENT.year}`,
    posterFileName: `genai-days-${EVENT.year}-affiche-officielle.png`,
    posterDownloadLabel: `Télécharger l’affiche officielle ${EVENT.year}`,
    symbolAlt: "Symbole de l’événement",
    symbolTitle: "Symbole vectoriel",
    symbolSummary:
      "SVG · Fond transparent · Proportions et couleurs du symbole à respecter · Aucun effet ajouté",
    symbolFileName: "genai-days-symbole.svg",
    symbolDownloadLabel: "Télécharger le symbole vectoriel",
    interviewsTitle: "Pour une interview.",
    interviewsLede:
      "Trois porte-paroles pour apporter un éclairage technique, communautaire ou territorial.",
    portraitAlt: (name: string) => `Portrait de ${name}`,
    requestInterview: "Demander une interview",
    promptTitle: "À ajouter à votre prompt Midjourney.",
    promptLede: "Paramètres de style des illustrations des conférences : à coller à la fin d’un prompt pour garder la même charte graphique.",
    copyPrompt: "Copier les paramètres",
    contactTitle: "Une question ou une accréditation ?",
    contactCta: "Écrire au contact presse",
  },
  en: {
    pageTitle: `Press kit ${EVENT.year} · GENAI DAYS`,
    pageDescription: `Press kit for GENAI DAYS ${EVENT.year} in ${EVENT.venue.city}: key facts, two tracks, program, official visual, ${illustrationCount} talk illustrations, ${pressTeamCount} team portraits and press contact.`,
    title: "Press kit",
    lede: `Ready-to-publish copy, facts and visuals for covering the ${EVENT.year} edition in ${EVENT.venue.city}.`,
    downloadKit: "Download the press kit",
    heroDownloadMeta: "ZIP · PDF, visuals, illustrations and portraits",
    pressContact: "Press contact",
    summaryTitle: "At a glance.",
    summaryMeta: "Ready-to-publish overview",
    copySummary: "Copy the overview",
    factSheetTitle: "Fact sheet.",
    practicalDetails: [
      { label: "Date", value: eventDate },
      { label: "Hours", value: `${EVENT.startTime} to ${EVENT.endTime}` },
      { label: "Venue", value: EVENT.venue.name },
      {
        label: "Address",
        value: `${EVENT.venue.address}, ${EVENT.venue.postalCode} ${EVENT.venue.city}`,
      },
      { label: "Organizer", value: `${EVENT.organizer.name}, a nonprofit association` },
      ...(supporter ? [{ label: "Supported by", value: supporter.name }] : []),
      { label: "Capacity", value: `${PRICING.capacity} attendees` },
      {
        label: "Format",
        value: "Talks, case studies and networking",
      },
      { label: "Language", value: "All talks are delivered in French" },
    ],
    factSeparator: ": ",
    copyFacts: "Copy the key facts",
    anglesTitle: "Three angles for covering the event.",
    anglesLede:
      "Ready-to-use topics that connect leadership concerns with the realities of implementation.",
    editorialAngles: [
      {
        title: "Making decisions about AI.",
        description:
          "Costs, governance, sovereignty, compliance and return on investment.",
      },
      {
        title: "Moving from prototypes to production.",
        description: "Architectures, agents, evaluation, data and observability.",
      },
      {
        title: "Sharing lessons from the field.",
        description:
          "Documented choices, concrete methods and case studies.",
      },
    ],
    tracksLabel: "Two complementary tracks",
    programmeCta: "See the full program",
    resourcesTitle: "Downloads.",
    resourcesLede:
      "The essential files, their formats and the credit lines to use when publishing.",
    packageTitle: "The complete press kit.",
    packageText: `A PDF in French with the program, speakers and partners, plus the official visual, the vector wordmark and symbol, ${illustrationCount} talk illustrations and ${pressTeamCount} portraits of the organizing team.`,
    packageMeta: `ZIP · ${pressKitFileCount} files`,
    download: "Download",
    coverAlt: `Official visual for the ${EVENT.year} edition`,
    coverTitle: `Official ${EVENT.year} visual`,
    coverFileName: `genai-days-${EVENT.year}-official-visual.webp`,
    coverDownloadLabel: `Download the official ${EVENT.year} visual`,
    posterAlt: `Official ${EVENT.year} poster with title, date and venue in French`,
    posterTitle: `Official ${EVENT.year} poster`,
    posterFileName: `genai-days-${EVENT.year}-official-poster.png`,
    posterDownloadLabel: `Download the official ${EVENT.year} poster`,
    symbolAlt: "Event symbol",
    symbolTitle: "Vector symbol",
    symbolSummary:
      "SVG · Transparent background · Keep the symbol’s proportions and colors · No added effects",
    symbolFileName: "genai-days-symbol.svg",
    symbolDownloadLabel: "Download the vector symbol",
    interviewsTitle: "For interviews.",
    interviewsLede:
      "Three spokespeople for a technical, community or regional perspective.",
    portraitAlt: (name: string) => `Portrait of ${name}`,
    requestInterview: "Request an interview",
    promptTitle: "Add this to your Midjourney prompt.",
    promptLede: "Style parameters of the talk illustrations: paste them at the end of a prompt to keep the same visual identity.",
    copyPrompt: "Copy the parameters",
    contactTitle: "Questions or press accreditation?",
    contactCta: "Write to our press contact",
  },
}[locale];

const pressFactsText = copy.practicalDetails
  .map((detail) => `${detail.label}${copy.factSeparator}${detail.value}`)
  .join("\n");

const spokespeople = [
  {
    name: maxime.name,
    role: maxime.role,
    topics: maxime.background,
    photo: "/organisateurs/maxime-pitussi-optimized.webp",
    photoWidth: 600,
    photoHeight: 600,
  },
  {
    name: samuel.name,
    role: samuel.role,
    topics: samuel.background,
    photo: "/organisateurs/samuel-berthe-optimized.webp",
    photoWidth: 600,
    photoHeight: 600,
  },
  {
    name: regionSpokesperson.name,
    role: regionSpokespersonCopy.role,
    topics: regionSpokespersonCopy.topics,
    photo: regionSpokesperson.photo,
    photoWidth: regionSpokesperson.photoWidth,
    photoHeight: regionSpokesperson.photoHeight,
  },
];

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const pressKitJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: copy.pageTitle,
  description: copy.pageDescription,
  url: new URL(localizePath("/press-kit", locale), siteUrl).href,
  inLanguage: locale,
  about: { "@id": `${siteUrl}#event` },
  publisher: { "@id": `${siteUrl}#organizer` },
  primaryImageOfPage: {
    "@type": "ImageObject",
    contentUrl: `${siteUrl}images/cover_v2-optimized.webp`,
    creditText: EVENT.name,
  },
};
---

<BaseLayout
  title={copy.pageTitle}
  description={copy.pageDescription}
  structuredData={[pressKitJsonLd]}
>
  <Header />
  <main class="press-page">
    <DirectoryHero
      title={copy.title}
      titleId="press-kit-title"
      lede={copy.lede}
      image="/images/cover_v2-optimized.webp"
      imageWidth={2560}
      imageHeight={1454}
      imagePosition="50% 50%"
    >
      <div class="press-hero-actions">
        <PressDownloadAction
          href="/press/genai-days-press-kit.zip"
          label={copy.downloadKit}
          meta={copy.heroDownloadMeta}
        />
        <PressContactAction tone="night">{copy.pressContact}</PressContactAction>
      </div>
    </DirectoryHero>

    <section
      id="essentiel"
      class="press-section"
      aria-labelledby="essentiel-title"
    >
      <EditorialGrid />
      <div class="press-shell press-brief">
        <article class="press-summary">
          <h2 id="essentiel-title" class="type-section-title">{copy.summaryTitle}</h2>
          <p class="press-meta">{copy.summaryMeta}</p>
          <p id="press-summary" class="press-summary__text">
            {locale === "en" ? (
              <>
                <EventName /> is a one-day conference on generative artificial
                intelligence for decision-makers and their technical teams.
                Organized by the {EVENT.organizer.name} association{supporter && ` with the support of the ${supporter.name}`},
                it takes place on {eventDate}, in {EVENT.venue.city}{" "}
                ({EVENT.venue.name}). The event brings together the people who
                decide on, build and implement AI every day. Two complementary
                tracks shape the day: a “For those who decide” track focused on
                strategy, governance and return on investment, and a “For those
                who implement” track covering architectures, tools and
                real-world case studies.{keynoteSpeaker && (
                  <>
                    {" "}The program includes an opening keynote by {keynoteSpeaker.name}
                    {" "}({keynoteSpeaker.role}, {keynoteSpeaker.company}), a panel on
                    digital sovereignty{podcastName ? `, a Startup Contest and a live recording of the ${podcastName} podcast` : " and a Startup Contest"}.
                  </>
                )} Talks, practical discussions and networking make up a
                program delivered entirely in French.
              </>
            ) : (
              <>
                <EventName /> est une journée-conférence consacrée à l’intelligence artificielle
                générative, dédiée aux décideurs et à leurs équipes techniques. Organisée
                par l’association {EVENT.organizer.name}{supporter && ` avec le soutien de la ${supporter.name}`},
                elle se tient le {eventDate} à {EVENT.venue.city}{" "}
                ({EVENT.venue.name}). L’événement réunit celles et ceux qui
                décident, construisent et implémentent l’IA au quotidien. Deux
                parcours complémentaires rythment la journée&nbsp;: un parcours «
                Pour ceux qui décident » centré sur la stratégie, la gouvernance et
                le retour sur investissement, et un parcours « Pour ceux qui
                implémentent » dédié aux architectures, aux outils et aux retours
                d’expérience.{keynoteSpeaker && (
                  <>
                    {" "}Au programme&nbsp;: une keynote d’ouverture de {keynoteSpeaker.name},
                    {" "}{keynoteSpeaker.role.charAt(0).toLowerCase() + keynoteSpeaker.role.slice(1)} de la {keynoteSpeaker.company},
                    une table ronde sur la souveraineté numérique, un Startup Contest{podcastName && ` et l’enregistrement en public du podcast ${podcastName}`}.
                  </>
                )} Conférences, échanges concrets et rencontres composent
                un programme intégralement présenté en français.
              </>
            )}
          </p>
          <PressCopyAction
            target="press-summary"
            label={copy.copySummary}
          />
        </article>

        <aside class="press-fact-sheet" aria-labelledby="fact-sheet-title">
          <h3 id="fact-sheet-title">{copy.factSheetTitle}</h3>
          <dl>
            {
              copy.practicalDetails.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))
            }
          </dl>
          <p id="press-facts-copy" class="sr-only">{pressFactsText}</p>
          <PressCopyAction
            target="press-facts-copy"
            label={copy.copyFacts}
          />
        </aside>
      </div>
    </section>

    <section id="angles" class="press-section" aria-labelledby="angles-title">
      <EditorialGrid />
      <div class="press-shell">
        <div class="press-heading">
          <h2 id="angles-title" class="type-section-title">
            {copy.anglesTitle}
          </h2>
          <p>
            {copy.anglesLede}
          </p>
        </div>

        <div class="press-angles">
          {
            copy.editorialAngles.map((angle) => (
              <article>
                <h3>{angle.title}</h3>
                <p>{angle.description}</p>
              </article>
            ))
          }
        </div>

        <div class="press-programme-bridge">
          <div>
            <p>{copy.tracksLabel}</p>
            <div class="press-track-marks">
              <TrackMark track="decideurs" variant="label" locale={locale} />
              <TrackMark track="tech" variant="label" locale={locale} />
            </div>
          </div>
          <Button variant="tertiary" href={localizePath("/programme", locale)}
            >{copy.programmeCta}</Button
          >
        </div>
      </div>
    </section>

    <section
      id="ressources"
      class="press-section press-resources"
      aria-labelledby="ressources-title"
    >
      <EditorialGrid />
      <div class="press-shell">
        <div class="press-heading">
          <h2 id="ressources-title" class="type-section-title">
            {copy.resourcesTitle}
          </h2>
          <p>
            {copy.resourcesLede}
          </p>
        </div>

        <article class="press-package">
          <div class="press-package__intro">
            <h3>{copy.packageTitle}</h3>
            <p>
              {copy.packageText}
            </p>
          </div>
          <PressDownloadAction
            href="/press/genai-days-press-kit.zip"
            label={copy.downloadKit}
            meta={copy.packageMeta}
          />
        </article>

        <div class="press-resource-grid">
          <article class="press-resource">
            <div class="press-resource__visual">
              <img
                src="/images/cover_v2-optimized.webp"
                alt={copy.coverAlt}
                width="2560"
                height="1454"
                loading="lazy"
              />
            </div>
            <div class="press-resource__body">
              <div class="press-resource__details">
                <h3>{copy.coverTitle}</h3>
                <p class="press-resource__summary">
                  {locale === "en" ? (
                    <>WEBP · 2560 × 1454 px · Credit: <EventName /></>
                  ) : (
                    <>WEBP · 2560 × 1454 px · Crédit&nbsp;: <EventName /></>
                  )}
                </p>
              </div>
              <a
                href="/press/genai-days-press-kit/cover_v2-optimized.webp"
                download={copy.coverFileName}
                aria-label={copy.coverDownloadLabel}
              >
                {copy.download} <DownloadIcon />
              </a>
            </div>
          </article>

          <article class="press-resource">
            <div class="press-resource__visual">
              <img
                src="/images/cover-poster-optimized.webp"
                alt={copy.posterAlt}
                width="1920"
                height="1080"
                loading="lazy"
              />
            </div>
            <div class="press-resource__body">
              <div class="press-resource__details">
                <h3>{copy.posterTitle}</h3>
                <p class="press-resource__summary">
                  {locale === "en" ? (
                    <>PNG · 1920 × 1080 px · Title, date and venue in French · Credit: <EventName /></>
                  ) : (
                    <>PNG · 1920 × 1080 px · Titre, date et lieu inclus · Crédit&nbsp;: <EventName /></>
                  )}
                </p>
              </div>
              <a
                href="/images/cover-poster.png"
                download={copy.posterFileName}
                aria-label={copy.posterDownloadLabel}
              >
                {copy.download} <DownloadIcon />
              </a>
            </div>
          </article>

          <article class="press-resource">
            <div class="press-resource__visual press-resource__visual--logo">
              <img
                src="/logos/Gen AI Logo.svg"
                alt={copy.symbolAlt}
                loading="lazy"
              />
            </div>
            <div class="press-resource__body">
              <div class="press-resource__details">
                <h3>{copy.symbolTitle}</h3>
                <p class="press-resource__summary">
                  {copy.symbolSummary}
                </p>
              </div>
              <a
                href="/logos/Gen AI Logo.svg"
                download={copy.symbolFileName}
                aria-label={copy.symbolDownloadLabel}
              >
                {copy.download} <DownloadIcon />
              </a>
            </div>
          </article>
        </div>

        <div class="press-prompt">
          <h3>{copy.promptTitle}</h3>
          <p>{copy.promptLede}</p>
          <div class="press-prompt__row">
            <code id="midjourney-prompt" class="press-prompt__code">{PRESS.midjourneyStyle}</code>
            <PressCopyAction target="midjourney-prompt" label={copy.copyPrompt} />
          </div>
        </div>
      </div>
    </section>

    <section
      id="interviews"
      class="press-section"
      aria-labelledby="interviews-title"
    >
      <EditorialGrid />
      <div class="press-shell">
        <div class="press-heading">
          <h2 id="interviews-title" class="type-section-title">
            {copy.interviewsTitle}
          </h2>
          <p>
            {copy.interviewsLede}
          </p>
        </div>

        <div class="press-spokespeople">
          {
            spokespeople.map((person) => (
              <article class="press-spokesperson">
                <img
                  src={person.photo}
                  alt={copy.portraitAlt(person.name)}
                  width={person.photoWidth}
                  height={person.photoHeight}
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  draggable="false"
                />
                <div class="press-spokesperson__body">
                  <h3>{person.name}</h3>
                  <p class="press-spokesperson__role">{person.role}</p>
                  <p>{person.topics}</p>
                  <PressContactAction class="press-interview-action">
                    {copy.requestInterview}
                  </PressContactAction>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="contact-presse"
      class="press-section"
      aria-labelledby="contact-title"
    >
      <EditorialGrid />
      <div class="press-shell press-contact">
        <div>
          <h2 id="contact-title" class="type-section-title">
            {copy.contactTitle}
          </h2>
          <p>
            {locale === "en" ? (
              <>
                The <EventName /> team answers press requests and arranges
                useful introductions.
              </>
            ) : (
              <>
                L’équipe <EventName /> répond aux demandes de la presse et organise les
                mises en relation utiles.
              </>
            )}
          </p>
        </div>
        <PressContactAction class="press-final-contact"
          >{copy.contactCta}</PressContactAction
        >
      </div>
    </section>

    <div class="sr-only" role="status" aria-live="polite" data-copy-live></div>
  </main>
  <Footer />
  <script>
    import { initPressKitCopy } from "../scripts/press-kit-copy";

    initPressKitCopy();
  </script>
</BaseLayout>

<style>
  .press-shell {
    position: relative;
    z-index: 3;
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    margin-inline: auto;
  }

  .press-page :global(.directory-hero__copy) {
    max-width: 40rem;
  }

  .press-page :global(.directory-hero__copy .type-page-title) {
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 0.95;
  }

  .press-page :global(.directory-hero__copy .type-page-lede) {
    max-width: 32rem;
  }

  .press-page :global(.directory-hero__actions) {
    display: block;
    margin-top: 0.75rem;
  }

  .press-hero-actions {
    display: grid;
    width: min(100%, 30rem);
    justify-items: start;
    gap: 0.75rem;
  }

  .press-section {
    position: relative;
    background: var(--color-brand-cream);
  }

  .press-section > .press-shell {
    padding: clamp(4rem, 8vw, 6.5rem) clamp(1.5rem, 3vw, 2.75rem);
  }

