---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandText from '../../components/BrandText.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TrackMark from '../../components/TrackMark';
import { EVENT, EVENT_YEAR } from '../../lib/event';
import { SPEAKER_EVENT_ROLE_LABELS, SPEAKER_PORTRAIT_DIMENSIONS, getSpeakerPagePaths, getSpeakerPortraitSrcset, trackForSpeaker } from '../../lib/speakers';
import { getLocaleFromPath, localizePath } from '../../lib/i18n';
import { getLocalizedCollection, localizeEntry } from '../../lib/localized-content';
import { stripMarkdownToPlainText } from '../../lib/markdown';

export const getStaticPaths = getSpeakerPagePaths;

const locale = getLocaleFromPath(Astro.url.pathname);
const props = Astro.props as {
  speaker: CollectionEntry<'speakers'>;
  sessions: CollectionEntry<'sessions'>[];
};
const speaker = await localizeEntry(props.speaker, locale);
const sessions = await Promise.all(props.sessions.map((session) => localizeEntry(session, locale)));

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href;
const directoryPath = localizePath('/speakers', locale);
const speakerUrl = new URL(localizePath(`/speakers/${speaker.id}`, locale), siteUrl).href;
const portrait = SPEAKER_PORTRAIT_DIMENSIONS[speaker.id];
const eventRoleLabel = speaker.data.eventRole ? SPEAKER_EVENT_ROLE_LABELS[locale][speaker.data.eventRole] : undefined;
const speakerTrack = trackForSpeaker(speaker.id, sessions);

const copy = {
  fr: {
    pageTitle: `${speaker.data.name} · ${eventRoleLabel ?? 'Intervenant'} GENAI DAYS ${EVENT_YEAR}`,
    pageDescriptionSuffix: ` ${eventRoleLabel ?? 'Intervenant'} à GENAI DAYS ${EVENT_YEAR} à ${EVENT.venue.city}.`,
    homeLabel: 'Accueil',
    directoryLabel: 'Intervenants',
    backLink: 'Tous les intervenants',
    portraitAlt: `Portrait de ${speaker.data.name}`,
    companyLogoAlt: (company: string) => `Logo ${company}`,
    socialLinksLabel: `Liens de ${speaker.data.name}`,
    websiteLabel: 'Site web',
    profileKicker: 'Portrait',
    profileTitle: 'Son parcours',
    legitimacyKicker: 'Son regard',
    legitimacyTitle: 'Sa légitimité numérique et GenAI',
    timelineKicker: 'Repères',
    timelineTitle: 'Parcours en bref',
    companiesKicker: 'Écosystème',
    companiesTitle: 'Les entreprises qui jalonnent son parcours',
    singleCompanyTitle: 'L’entreprise associée à son parcours',
    companyLink: (company: string) => `Découvrir ${company}`,
    sessionsKicker: 'Au programme',
    sessionsTitle: 'Ses sessions',
    singleSessionTitle: 'Sa session',
    quotedTitle: (title: string) => `"${title}"`,
    themesLabel: 'Thématiques',
    sharedSessionRoom: 'Temps commun',
  },
  en: {
    pageTitle: `${speaker.data.name} · ${eventRoleLabel ?? 'Speaker'} · GENAI DAYS ${EVENT_YEAR}`,
    pageDescriptionSuffix: ` ${eventRoleLabel ?? 'Speaker'} at GENAI DAYS ${EVENT_YEAR} in ${EVENT.venue.city}.`,
    homeLabel: 'Home',
    directoryLabel: 'Speakers',
    backLink: 'All speakers',
    portraitAlt: `Portrait of ${speaker.data.name}`,
    companyLogoAlt: (company: string) => `${company} logo`,
    socialLinksLabel: `${speaker.data.name} on the web`,
    websiteLabel: 'Website',
    profileKicker: 'Profile',
    profileTitle: 'Background',
    legitimacyKicker: 'Perspective',
    legitimacyTitle: 'Digital and GenAI credentials',
    timelineKicker: 'Milestones',
    timelineTitle: 'Career at a glance',
    companiesKicker: 'Ecosystem',
    companiesTitle: 'Organizations along the way',
    singleCompanyTitle: 'Their organization',
    companyLink: (company: string) => `Visit ${company}`,
    sessionsKicker: 'On the program',
    sessionsTitle: 'Their sessions',
    singleSessionTitle: 'Their session',
    quotedTitle: (title: string) => `“${title}”`,
    themesLabel: 'Topics',
    sharedSessionRoom: 'All tracks',
  },
}[locale];

const tracks = await getLocalizedCollection('tracks', locale);
const trackById = new Map(tracks.map((track) => [track.id, track.data]));
/* Le `room` de la plupart des sessions ne fait que répéter le nom de son
 * parcours : quand il est vide, on retombe sur ce nom plutôt que d'afficher
 * une salle vide. */
const roomFor = (session: CollectionEntry<'sessions'>) =>
  session.data.room ||
  (trackById.get(session.data.track)?.name ?? (session.data.track === 'commun' ? copy.sharedSessionRoom : session.data.track));

// Tronque au dernier espace avant la limite pour ne jamais couper un mot en deux.
function truncateAtWordBoundary(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  const truncated = text.slice(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  return `${(lastSpace > 0 ? truncated.slice(0, lastSpace) : truncated).trimEnd()}…`;
}

// Dérivée de la bio (unique par intervenant·e) plutôt que du gabarit nom/rôle/entreprise,
// identique à quelques mots près d'une fiche à l'autre.
const pageDescription = `${truncateAtWordBoundary(speaker.data.bio, 155 - copy.pageDescriptionSuffix.length)}${copy.pageDescriptionSuffix}`;

const speakerJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${speakerUrl}#person`,
  name: speaker.data.name,
  url: speakerUrl,
  jobTitle: speaker.data.role,
  description: speaker.data.bio,
  worksFor: { '@type': 'Organization', name: speaker.data.company },
  ...(speaker.data.photo ? { image: new URL(speaker.data.photo, siteUrl).href } : {}),
  sameAs: [speaker.data.linkedin, speaker.data.website, speaker.data.x].filter((url): url is string => Boolean(url)),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.homeLabel, item: new URL(localizePath('/', locale), siteUrl).href },
    { '@type': 'ListItem', position: 2, name: copy.directoryLabel, item: new URL(directoryPath, siteUrl).href },
    { '@type': 'ListItem', position: 3, name: speaker.data.name, item: speakerUrl },
  ],
};

// Le portrait remplace la cover de la journée dans les aperçus de partage ;
// sans photo, BaseLayout retombe sur la cover.
const socialImage = speaker.data.photo
  ? {
      src: speaker.data.photo,
      alt: copy.portraitAlt,
      width: portrait?.width,
      height: portrait?.height,
    }
  : undefined;

const socialLinks = [
  speaker.data.linkedin && { label: 'LinkedIn', href: speaker.data.linkedin },
  speaker.data.website && { label: copy.websiteLabel, href: speaker.data.website },
  speaker.data.x && { label: 'X', href: speaker.data.x },
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<BaseLayout
  title={copy.pageTitle}
  description={pageDescription}
  socialImage={socialImage}
  structuredData={[speakerJsonLd, breadcrumbJsonLd]}
>
  <Header />
  <main>
    <section class="speaker-hero bg-brand-black px-6 py-14 text-white sm:py-18">
      <div class="mx-auto max-w-5xl">
        {/* Le lien nomme sa destination au lieu de revendiquer une provenance :
            on arrive ici depuis le carrousel de la landing, depuis /speakers,
            depuis le planning ou depuis une fiche session, et « Retour au
            programme » mentait dans trois cas sur quatre. Même geste que
            « Tous les partenaires » sur la fiche partenaire. */}
        <a href={directoryPath} class="speaker-back-link">
          <span aria-hidden="true">←</span>
          {copy.backLink}
        </a>
        <div class="mt-10 grid gap-9 sm:grid-cols-[14rem_1fr] sm:items-end lg:gap-14">
          <div class="speaker-page-photo">
            {speaker.data.photo ? (
              <img
                class="portrait-photo"
                src={speaker.data.photo}
                srcset={getSpeakerPortraitSrcset(speaker.id, speaker.data.photo)}
                sizes="(min-width: 40rem) 14rem, min(15rem, 76vw)"
                alt={copy.portraitAlt}
                width={portrait?.width}
                height={portrait?.height}
                draggable="false"
              />
            ) : (
              <span class="speaker-page-photo__fallback" aria-hidden="true">{speaker.data.name.slice(0, 1)}</span>
            )}
            {speaker.data.companyLogo && (
              <span class="speaker-page-company-logo">
                <img
                  src={speaker.data.companyLogoOnDark ?? speaker.data.companyLogo}
                  alt={speaker.data.companyLogoAlt ?? copy.companyLogoAlt(speaker.data.company)}
                  width="56"
                  height="56"
                />
              </span>
            )}
          </div>
          <div>
            <div class="speaker-kicker">
              {eventRoleLabel && <span>{eventRoleLabel}</span>}
              {eventRoleLabel && <span aria-hidden="true">·</span>}
              {speakerTrack && <TrackMark track={speakerTrack} locale={locale} />}
            </div>
            <h1 class="mt-4 text-4xl font-black leading-none tracking-tight sm:text-6xl">{speaker.data.name}</h1>
            <p class="mt-5 text-lg font-bold text-white/78 sm:text-xl">{speaker.data.role} · {speaker.data.company}</p>
            {socialLinks.length > 0 && (
              <nav class="speaker-social-links mt-7" aria-label={copy.socialLinksLabel}>
                {socialLinks.map((link) => (
                  <a href={link.href} rel="noopener noreferrer" target="_blank">{link.label}</a>
                ))}
              </nav>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
      <div class="speaker-story-grid">
        <article>
          <p class="type-section-kicker text-brand-blue">{copy.profileKicker}</p>
          <h2 class="type-section-title mt-3">{copy.profileTitle}</h2>
          <div class="speaker-prose mt-6">
            {speaker.data.profile.map((paragraph) => (
              <p><BrandText text={paragraph} /></p>
            ))}
          </div>

          <section class="speaker-legitimacy mt-12" aria-labelledby="speaker-legitimacy-title">
            <p class="type-section-kicker text-brand-blue">{copy.legitimacyKicker}</p>
            <h2 id="speaker-legitimacy-title" class="type-section-title mt-3">{copy.legitimacyTitle}</h2>
            <p class="mt-5 text-lg leading-relaxed text-black/72">
              <BrandText text={speaker.data.genaiLegitimacy} />
            </p>
          </section>
        </article>

        <aside class="speaker-timeline" aria-labelledby="speaker-timeline-title">
          <p class="type-section-kicker text-brand-blue">{copy.timelineKicker}</p>
          <h2 id="speaker-timeline-title" class="mt-2 text-2xl font-extrabold">{copy.timelineTitle}</h2>
          <ol class="mt-7 space-y-7">
            {speaker.data.careerHighlights.map((highlight) => (
              <li>
                <p class="speaker-timeline__period">{highlight.period}</p>
                <h3 class="mt-1 text-lg font-extrabold leading-tight">{highlight.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-black/62">
                  <BrandText text={highlight.description} />
                </p>
              </li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    {speaker.data.companies && (
    <section class="speaker-companies px-6 py-14 sm:py-20" aria-labelledby="speaker-companies-title">
      <div class="mx-auto max-w-5xl">
        <p class="type-section-kicker text-brand-blue">{copy.companiesKicker}</p>
        <h2 id="speaker-companies-title" class="type-section-title mt-3">
          {speaker.data.companies.length > 1 ? copy.companiesTitle : copy.singleCompanyTitle}
        </h2>
        <div class:list={['mt-8 grid gap-5', speaker.data.companies.length > 1 && 'md:grid-cols-2 xl:grid-cols-3']}>
          {speaker.data.companies.map((company, index) => (
            <article class:list={['company-profile-card', index % 2 === 1 && 'company-profile-card--blue']}>
              <div class="company-profile-card__heading">
                <div class="company-profile-card__logo">
                  {company.logo ? (
                    <img src={company.logo} alt={copy.companyLogoAlt(company.name)} loading="lazy" />
                  ) : (
                    <span aria-hidden="true">{company.name.slice(0, 1)}</span>
                  )}
                </div>
                <div>
                  <h3>{company.name}</h3>
                  <p>{company.relationship}</p>
                </div>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-black/68">
                <BrandText text={company.description} />
              </p>
              <a class="company-profile-card__link" href={company.website} rel="noopener noreferrer" target="_blank">
                {copy.companyLink(company.name)}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    )}

    {sessions.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 py-14 sm:py-20" aria-labelledby="speaker-sessions-title">
        <p class="type-section-kicker text-brand-blue">{copy.sessionsKicker}</p>
        <h2 id="speaker-sessions-title" class="type-section-title mt-3">
          {sessions.length > 1 ? copy.sessionsTitle : copy.singleSessionTitle}
        </h2>
        <div class="mt-8 grid gap-5">
          {sessions.map((session) => (
            <a class="speaker-session-card" href={localizePath(`/programme/${session.id}`, locale)}>
              <div class="speaker-session-card__meta">
                <span>{session.data.startTime}</span>
                <span>{roomFor(session)}</span>
                <span>{session.data.durationMinutes} min</span>
              </div>
              <div>
                <h3>{session.data.quoteTitle ? copy.quotedTitle(session.data.title) : session.data.title}</h3>
                {session.body?.trim() && (
                  <p><BrandText text={stripMarkdownToPlainText(session.body)} /></p>
                )}
                {session.data.themes && (
                  <ul aria-label={copy.themesLabel}>
                    {session.data.themes.map((theme) => <li>{theme}</li>)}
                  </ul>
                )}
              </div>
              <span class="speaker-session-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>

<style>
  .speaker-hero {
    background:
      radial-gradient(circle at 82% 16%, rgb(26 84 255 / 30%), transparent 28rem),
      radial-gradient(circle at 15% 90%, rgb(255 98 0 / 18%), transparent 24rem),
      var(--color-brand-black);
  }

  .speaker-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.5rem;
    color: rgb(255 255 255 / 62%);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .speaker-back-link:hover {
    color: var(--color-brand-white);
  }

  .speaker-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    color: rgb(255 255 255 / 68%);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .speaker-page-photo {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 72%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 12%), transparent),
      linear-gradient(135deg, var(--color-brand-blue), var(--color-brand-orange));
    box-shadow: 0.65rem 0.65rem 0 rgb(255 255 255 / 12%);
    transform: rotate(-1.5deg);
  }

  .speaker-page-photo > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .speaker-page-photo__fallback {
    color: var(--color-brand-white);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 900;
    line-height: 1;
  }

  .speaker-page-photo .speaker-page-company-logo {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    overflow: hidden;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 0.4rem;
  }

  .speaker-page-company-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .speaker-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .speaker-social-links a {
    border: 1px solid rgb(255 255 255 / 34%);
    padding: 0.55rem 0.8rem;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .speaker-social-links a:hover {
    border-color: var(--color-brand-orange);
    background: var(--color-brand-orange);
    color: var(--color-brand-black);
  }

  .speaker-story-grid {
    display: grid;
    gap: 3rem;
  }

  .speaker-prose {
    display: grid;
    gap: 1.15rem;
    max-width: 44rem;
    color: rgb(13 13 18 / 72%);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .speaker-legitimacy {
    max-width: 46rem;
    border-left: 0.35rem solid var(--color-brand-blue);
    padding: 0.25rem 0 0.25rem clamp(1.1rem, 3vw, 2rem);
  }

  .speaker-timeline {
    align-self: start;
    border: 1px solid rgb(13 13 18 / 12%);
    background: var(--color-brand-white);
    box-shadow: 0.45rem 0.45rem 0 var(--color-brand-blue);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .speaker-timeline li {
    position: relative;
    border-left: 2px solid rgb(13 13 18 / 12%);
    padding-left: 1.15rem;
  }

  .speaker-timeline li::before {
    position: absolute;
    top: 0.25rem;
    left: -0.4rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--color-brand-white);
    border-radius: 999px;
    background: var(--color-brand-orange);
    box-shadow: 0 0 0 1px var(--color-brand-orange);
    content: '';
  }

  .speaker-timeline__period {
    color: var(--color-brand-blue);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .speaker-companies {
    background:
      linear-gradient(135deg, rgb(255 98 0 / 8%), transparent 32rem),
      rgb(13 13 18 / 3%);
  }

  .company-profile-card {
    display: flex;
    flex-direction: column;
    border-top: 0.35rem solid var(--color-brand-orange);
    background: var(--color-brand-white);
    box-shadow: 0 0.7rem 1.8rem rgb(13 13 18 / 8%);
    padding: clamp(1.2rem, 3vw, 1.65rem);
  }

  .company-profile-card--blue {
    border-color: var(--color-brand-blue);
  }

  .company-profile-card__heading {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .company-profile-card__logo {
    display: grid;
    box-sizing: border-box;
    overflow: hidden;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.35rem;
    place-items: center;
    border-radius: 0.45rem;
    background: var(--color-brand-white);
    color: var(--color-brand-black);
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 800;
  }

  .company-profile-card__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .company-profile-card__heading h3 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
  }

  .company-profile-card__heading p {
    margin-top: 0.35rem;
    color: rgb(13 13 18 / 68%);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .company-profile-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 1.35rem;
    color: var(--color-brand-blue);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .company-profile-card__link:hover {
    color: var(--color-brand-orange);
  }

  .speaker-session-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 11rem) minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    border: 1px solid rgb(13 13 18 / 12%);
    border-left: 0.45rem solid var(--color-brand-blue);
    background: var(--color-brand-white);
    padding: clamp(1.25rem, 4vw, 2rem);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .speaker-session-card:hover {
    box-shadow: 0.45rem 0.45rem 0 var(--color-brand-orange);
    transform: translate(-0.15rem, -0.15rem);
  }

  .speaker-session-card__meta {
    display: grid;
    gap: 0.35rem;
    color: rgb(13 13 18 / 68%);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .speaker-session-card h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4vw, 2.15rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .speaker-session-card p {
    margin-top: 0.7rem;
    max-width: 44rem;
    color: rgb(13 13 18 / 66%);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .speaker-session-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .speaker-session-card li {
    background: rgb(26 84 255 / 10%);
    padding: 0.35rem 0.55rem;
    color: var(--color-brand-blue);
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .speaker-session-card__arrow {
    color: var(--color-brand-orange);
    font-size: 1.8rem;
    font-weight: 900;
  }

  @media (min-width: 64rem) {
    .speaker-story-grid {
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 4.5rem;
    }
  }

  @media (max-width: 39.999rem) {
    .speaker-page-photo {
      width: min(15rem, 76vw);
    }

    .speaker-session-card {
      grid-template-columns: 1fr auto;
    }

    .speaker-session-card__meta {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 0.7rem;
    }
  }
</style>
