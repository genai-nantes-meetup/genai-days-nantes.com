---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandText from "../components/BrandText.astro";
import EventName from "../components/EventName.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EVENT from "../content/event.json";
import { EVENT_URL } from "../lib/event";

const pageSections = [
  { label: "Mentions légales", href: "#mentions-legales" },
  { label: "Données personnelles", href: "#donnees-personnelles" },
  { label: "Traceurs et services tiers", href: "#traceurs" },
  { label: "Vos droits", href: "#vos-droits" },
  { label: "Propriété et responsabilité", href: "#propriete" },
];

const dataTreatments = [
  {
    activity: "Navigation et sécurité",
    data: "Adresse IP, date et heure, page demandée, informations techniques du navigateur et journaux d’erreur.",
    purpose:
      "Afficher le site, garantir sa disponibilité, prévenir les abus et diagnostiquer les incidents.",
    basis: "Intérêt légitime de Naomakers à exploiter et sécuriser le site.",
    retention:
      "Durée strictement nécessaire à l’exploitation et à la sécurité, dans la limite des durées techniques appliquées par l’hébergeur.",
  },
  {
    activity: "Inscription à la récompense des stickers",
    data: "Nom, prénom, adresse e-mail, téléphone, identifiants des stickers collectés et date de l’inscription.",
    purpose:
      "Vérifier l’éligibilité, inscrire la personne gagnante, préparer la récompense et organiser sa remise.",
    basis:
      "Exécution des mesures prises à votre demande et de l’engagement de remise de la récompense.",
    retention: `Jusqu’au 17 février 2027, soit trois mois après GenAI Days ${EVENT.year}, puis suppression des espaces de travail actifs.`,
  },
  {
    activity: "Demandes envoyées par e-mail",
    data: "Identité, coordonnées, contenu du message et informations nécessaires au suivi de la demande.",
    purpose:
      "Répondre aux questions et gérer les échanges avec les participants, intervenants, partenaires et médias.",
    basis:
      "Intérêt légitime à répondre aux demandes ou mesures précontractuelles lorsque la demande concerne un partenariat.",
    retention:
      "Temps nécessaire au traitement, puis jusqu’à trois ans après le dernier échange, sauf obligation légale ou litige.",
  },
];

const localStorageItems = [
  {
    name: "Archive de stickers",
    key: "genaidays:label-archive:v5",
    purpose:
      "Mémoriser les stickers collectés et leur position dans l’interface.",
  },
  {
    name: "Parcours de récompense",
    key: "genaidays:sticker-reward:v1",
    purpose:
      "Mémoriser localement l’ouverture de l’étape finale puis, après inscription, le prénom et la date de validation.",
  },
  {
    name: "Effet de brillance",
    key: "genai-days:shiny-permission",
    purpose:
      "Mémoriser le choix d’activer l’effet lié aux capteurs de mouvement sur un appareil compatible.",
  },
];
---

<BaseLayout
  title="Confidentialité & Mentions légales · GenAI Days"
  description="Mentions légales, politique de confidentialité, traitements de données personnelles, traceurs et modalités d’exercice de vos droits sur le site GenAI Days."
>
  <Header />

  <main>
    <section class="legal-hero px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <p class="legal-kicker">CADRE LÉGAL · ${EVENT_URL}</p>
        <h1
          class="mt-6 max-w-5xl text-[2.5rem] leading-[0.88] sm:text-7xl lg:text-8xl"
        >
          Confidentialité<br />& Mentions légales
        </h1>
        <div
          class="mt-10 grid gap-6 border-t border-black/15 pt-6 text-sm sm:grid-cols-2 lg:grid-cols-3"
        >
          <p>
            <strong class="block text-brand-blue">Éditeur</strong>
            Association Naomakers · Nantes
          </p>
          <p>
            <strong class="block text-brand-blue">Contact</strong>
            {EVENT.contactEmail}
          </p>
        </div>
      </div>
    </section>

    <div class="bg-brand-white px-6 py-14 sm:py-20">
      <div
        class="legal-shell mx-auto grid max-w-6xl gap-12 lg:grid-cols-[16rem_minmax(0,1fr)]"
      >
        <aside>
          <nav class="legal-toc" aria-label="Sommaire de la page">
            <p class="legal-toc__title">SOMMAIRE</p>
            <ol>
              {
                pageSections.map((section, index) => (
                  <li>
                    <a href={section.href}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      {section.label}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>

        <div class="legal-content">
          <section class="legal-summary" aria-labelledby="summary-heading">
            <p class="legal-section-number">EN BREF</p>
            <h2 id="summary-heading">Ce qu’il faut retenir</h2>
            <p>
              <EventName /> ne diffuse aucune publicité. Le site peut utiliser des
              outils de mesure d’audience à des fins statistiques et conserve des
              réglages fonctionnels sur votre appareil. Des données personnelles
              sont traitées lorsque vous écrivez à l’équipe ou vous inscrivez à la
              récompense des stickers.
            </p>
            <p>
              Naomakers ne vend ni ne loue vos données. Vous pouvez demander
              l’accès, la rectification ou l’effacement de vos informations en
              contactant l’équipe à {EVENT.contactEmail}.
            </p>
          </section>

          <section
            id="mentions-legales"
            class="legal-section"
            aria-labelledby="legal-heading"
          >
            <p class="legal-section-number">01 · IDENTIFICATION</p>
            <h2 id="legal-heading">Mentions légales</h2>

            <div class="legal-card-grid">
              <article class="legal-card">
                <h3>Éditeur du site</h3>
                <dl class="legal-details">
                  <div>
                    <dt>Dénomination</dt>
                    <dd>Naomakers</dd>
                  </div>
                  <div>
                    <dt>Forme</dt>
                    <dd>
                      Association déclarée régie par la loi du 1er juillet 1901
                    </dd>
                  </div>
                  <div>
                    <dt>Siège social</dt>
                    <dd>25 avenue des Préludes, 44300 Nantes, France</dd>
                  </div>
                  <div>
                    <dt>RNA</dt>
                    <dd>W442026186</dd>
                  </div>
                  <div>
                    <dt>SIREN</dt>
                    <dd>901 264 374</dd>
                  </div>
                  <div>
                    <dt>SIRET</dt>
                    <dd>901 264 374 00025</dd>
                  </div>
                  <div>
                    <dt>Contact</dt>
                    <dd>{EVENT.contactEmail}</dd>
                  </div>
                </dl>
              </article>

              <article class="legal-card legal-card--accent">
                <h3>Publication</h3>
                <p>
                  Le responsable de la publication est <strong
                    >Rémi Wetteren</strong
                  >.
                </p>
                <p class="mt-6">
                  Contact&nbsp;:{" "}
                  {EVENT.contactEmail}
                </p>
                <p class="mt-6">
                  La conception éditoriale et la maintenance du site sont
                  assurées pour <EventName /> sous la responsabilité de Naomakers.
                </p>
              </article>
            </div>

            <article class="legal-host">
              <div>
                <p class="legal-host__label">HÉBERGEMENT</p>
                <h3>Vercel Inc.</h3>
              </div>
              <address>
                440 N Barranca Avenue #4133<br />
                Covina, CA 91723 · États-Unis<br />
                <a href="tel:+15592887060">+1 559 288 7060</a><br />
                <a
                  href="https://vercel.com/legal/privacy-notice"
                  target="_blank"
                  rel="noreferrer"
                >
                  Politique de confidentialité ↗
                </a>
              </address>
            </article>
          </section>

          <section
            id="donnees-personnelles"
            class="legal-section"
            aria-labelledby="privacy-heading"
          >
            <p class="legal-section-number">02 · VIE PRIVÉE</p>
            <h2 id="privacy-heading">Données personnelles</h2>
            <p>
              Le responsable des traitements décrits ci-dessous est
              l’association Naomakers, aux coordonnées indiquées dans les
              mentions légales. Les données demandées dans le formulaire de
              récompense sont obligatoires&nbsp;: sans elles, l’équipe ne peut
              pas vérifier l’inscription ni organiser la remise. Aucune décision
              automatisée ni aucun profilage n’est réalisé.
            </p>

            <div
              class="legal-table-wrap"
              tabindex="0"
              role="region"
              aria-labelledby="privacy-table-caption"
            >
              <table>
                <caption id="privacy-table-caption"
                  >Traitements de données réalisés sur le site ou à partir de
                  ses contacts</caption
                >
                <thead>
                  <tr>
                    <th scope="col">Traitement</th>
                    <th scope="col">Données et finalité</th>
                    <th scope="col">Base légale et conservation</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    dataTreatments.map((treatment) => (
                      <tr>
                        <th scope="row">{treatment.activity}</th>
                        <td>
                          <strong>Données&nbsp;:</strong> {treatment.data}
                          <br />
                          <strong>Objectif&nbsp;:</strong> {treatment.purpose}
                        </td>
                        <td>
                          <strong>Base&nbsp;:</strong> {treatment.basis}
                          <br />
                          <strong>Durée&nbsp;:</strong>{" "}
                          <BrandText text={treatment.retention} />
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>

            <article class="legal-subsection">
              <h3>Destinataires et prestataires</h3>
              <p>
                Les données sont accessibles aux seuls membres habilités de
                l’équipe Naomakers et, selon le besoin, aux prestataires
                techniques agissant pour son compte&nbsp;:
              </p>
              <ul>
                <li>
                  <strong>Vercel Inc.</strong>, pour l’hébergement, la diffusion
                  et la sécurité du site.
                </li>
                <li>
                  <strong>Plus Five Five, Inc., sous la marque Resend</strong>,
                  pour transmettre les inscriptions à la récompense vers la
                  messagerie de l’équipe.
                </li>
                <li>
                  <strong>Google LLC</strong>, lorsque la messagerie de
                  réception ou l’adresse utilisée pour un échange est exploitée
                  avec un service Google.
                </li>
              </ul>
              <p>
                Ces prestataires peuvent traiter certaines données aux
                États-Unis. Lorsque le droit l’exige, ces transferts sont
                encadrés par une décision d’adéquation applicable, des clauses
                contractuelles types de la Commission européenne ou un autre
                mécanisme reconnu. Naomakers ne communique les données à aucune
                autre organisation, sauf obligation légale ou demande d’une
                autorité habilitée.
              </p>
            </article>

            <article class="legal-subsection">
              <h3>Sécurité</h3>
              <p>
                Naomakers applique des mesures raisonnables de limitation des
                accès, de validation des formulaires et de sécurisation des
                échanges. Aucun service en ligne ne pouvant garantir une
                sécurité absolue, l’association traite les incidents et ajuste
                ses protections selon les risques identifiés.
              </p>
            </article>
          </section>

          <section
            id="traceurs"
            class="legal-section"
            aria-labelledby="storage-heading"
          >
            <p class="legal-section-number">03 · NAVIGATEUR</p>
            <h2 id="storage-heading">Traceurs et services tiers</h2>
            <p>
              Le site ne dépose aucun traceur publicitaire. Il peut utiliser des
              outils de mesure d’audience à des fins statistiques internes, sans
              finalité publicitaire. Le stockage local du navigateur sert par
              ailleurs à fournir les fonctions interactives ci-dessous. Ces
              éléments restent sur votre appareil et ne servent pas à vous suivre
              sur d’autres sites.
            </p>

            <div class="legal-storage-list">
              {
                localStorageItems.map((item) => (
                  <article>
                    <div>
                      <p class="legal-storage-list__name">{item.name}</p>
                      <code>{item.key}</code>
                    </div>
                    <p>{item.purpose}</p>
                    <p>
                      <strong>Durée&nbsp;:</strong> jusqu’à la suppression des
                      données du site dans votre navigateur.
                    </p>
                  </article>
                ))
              }
            </div>

            <p>
              Vous pouvez supprimer ces informations depuis les réglages de
              votre navigateur, dans la rubrique consacrée aux données de sites.
              Cette suppression réinitialise la collection de stickers, le
              parcours de récompense et les préférences d’animation.
            </p>

            <article class="legal-subsection">
              <h3>Capteurs de mouvement</h3>
              <p>
                Sur les appareils compatibles, l’effet de brillance peut
                utiliser l’orientation du terminal après votre autorisation. Les
                valeurs des capteurs sont utilisées en temps réel dans le
                navigateur. Elles ne sont ni transmises à Naomakers ni
                enregistrées. Seul le choix d’activation peut être mémorisé
                localement.
              </p>
            </article>

            <article class="legal-subsection">
              <h3>Carte, médias et liens externes</h3>
              <p>
                La page d’accueil charge une carte fournie par OpenFreeMap, la
                bibliothèque MapLibre depuis UNPKG, ainsi que certains médias
                hébergés sur les sites de Shift et de L’Informateur Judiciaire.
                Lors de ces chargements, les serveurs concernés peuvent recevoir
                l’adresse IP et les informations techniques indispensables à la
                transmission du fichier. Naomakers utilise ces ressources pour
                présenter le lieu et les précédents événements, sur le fondement
                de son intérêt légitime à informer le public.
              </p>
              <p>
                Les liens vers Meetup, la billetterie, Google Maps, les hôtels,
                les partenaires et les réseaux sociaux ne transmettent pas de
                formulaire <EventName /> à ces services. Lorsque vous choisissez de
                les ouvrir, leurs propres règles de confidentialité s’appliquent.
              </p>
            </article>
          </section>

          <section
            id="vos-droits"
            class="legal-section legal-rights"
            aria-labelledby="rights-heading"
          >
            <p class="legal-section-number">04 · RGPD</p>
            <h2 id="rights-heading">Vos droits</h2>
            <p>
              Selon le traitement concerné, vous pouvez demander l’accès à vos
              données, leur rectification, leur effacement, la limitation de
              leur utilisation ou leur portabilité. Vous pouvez également vous
              opposer à un traitement fondé sur l’intérêt légitime et retirer
              votre consentement lorsqu’un traitement repose sur celui-ci.
            </p>
            <div class="legal-rights__action">
              <div>
                <p class="legal-rights__label">EXERCER UN DROIT</p>
                <h3>Écrivez à Naomakers</h3>
                <p>
                  Précisez la demande et l’adresse e-mail concernée. Un
                  justificatif d’identité ne sera demandé qu’en cas de doute
                  raisonnable sur votre identité.
                </p>
              </div>
              <a href={`mailto:${EVENT.contactEmail}`}>
                Préparer ma demande
                <span aria-hidden="true">→</span>
              </a>
            </div>
            <p>
              Naomakers répond dans un délai d’un mois, prolongeable de deux
              mois lorsque la demande est complexe ou nombreuse. Si vous estimez
              que vos droits ne sont pas respectés après avoir contacté
              l’association, vous pouvez adresser une réclamation à la{" "}
              <a
                class="legal-link"
                href="https://www.cnil.fr/fr/plaintes"
                target="_blank"
                rel="noreferrer"
              >
                Commission nationale de l’informatique et des libertés
              </a>.
            </p>
          </section>

          <section
            id="propriete"
            class="legal-section"
            aria-labelledby="property-heading"
          >
            <p class="legal-section-number">05 · UTILISATION DU SITE</p>
            <h2 id="property-heading">Propriété et responsabilité</h2>

            <article class="legal-subsection">
              <h3>Propriété intellectuelle</h3>
              <p>
                La structure du site, les textes, éléments graphiques, signes
                distinctifs et contenus produits pour <EventName /> sont protégés
                par les règles applicables à la propriété intellectuelle. Sauf indication
                contraire, toute reproduction, adaptation, représentation ou diffusion
                substantielle nécessite l’autorisation écrite préalable de Naomakers.
              </p>
              <p>
                Les marques, logos, portraits, témoignages et contenus
                appartenant aux intervenants, partenaires ou tiers restent la
                propriété de leurs titulaires respectifs. La photographie de
                l’Hôtel de Région est créditée Région Pays de la Loire · Ouest
                Médias.
              </p>
            </article>

            <article class="legal-subsection">
              <h3>Informations et liens</h3>
              <p>
                Naomakers veille à fournir des informations exactes et à jour,
                mais le programme, les tarifs, les intervenants, les
                disponibilités et les modalités pratiques peuvent évoluer. Les
                conditions opposables d’une réservation sont celles présentées
                par le service de billetterie au moment de l’opération.
              </p>
              <p>
                Les sites externes sont proposés à titre pratique. Naomakers ne
                contrôle ni leur contenu, ni leur disponibilité, ni leurs
                pratiques. L’association ne saurait être tenue responsable d’un
                dommage résultant exclusivement de l’utilisation d’un service
                tiers, sous réserve des dispositions légales impératives.
              </p>
            </article>

            <article class="legal-subsection">
              <h3>Disponibilité</h3>
              <p>
                L’accès au site peut être interrompu pour maintenance, incident
                ou mise à jour. Naomakers met en œuvre des moyens raisonnables
                pour rétablir le service, sans garantir une disponibilité
                continue ni l’absence totale d’erreur.
              </p>
            </article>
          </section>

          <section class="legal-update" aria-labelledby="update-heading">
            <p class="legal-section-number">ÉVOLUTION</p>
            <h2 id="update-heading">Mise à jour de cette page</h2>
            <p>
              Cette page peut évoluer pour refléter une modification du site,
              d’un prestataire ou de la réglementation. La date affichée en haut
              de page correspond à sa dernière révision. Pour toute question
              juridique ou relative à la confidentialité, contactez l’équipe à {EVENT.contactEmail}.
            </p>
          </section>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 86% 12%,
        rgb(254 77 27 / 18%),
        transparent 21rem
      ),
      linear-gradient(135deg, #faf8f3 0%, #f4f1e9 100%);
  }

  .legal-hero h1 {
    hyphens: auto;
  }

  .legal-hero::after {
    position: absolute;
    right: -5rem;
    bottom: -7rem;
    width: 20rem;
    height: 20rem;
    border: 2px solid rgb(61 67 206 / 22%);
    border-radius: 50%;
    content: "";
  }

  .legal-kicker,
  .legal-section-number,
  .legal-toc__title,
  .legal-host__label,
  .legal-rights__label {
    font-family: var(--font-label-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
  }

  .legal-link,
  .legal-details a,
  .legal-details button,
  .legal-host a {
    color: var(--color-brand-blue);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .legal-link,
  .legal-details button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
  }

  .legal-link--standalone {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
  }

  .legal-toc {
    position: sticky;
    top: 6.5rem;
  }

  .legal-toc__title {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(57 54 54 / 16%);
    color: rgb(57 54 54 / 72%);
  }

  .legal-toc ol {
    list-style: none;
  }

  .legal-toc a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgb(57 54 54 / 10%);
    color: rgb(57 54 54 / 72%);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .legal-toc a:hover,
  .legal-toc a:focus-visible {
    color: var(--color-brand-blue);
  }

  .legal-toc a span {
    /* Sur blanc, l'orange ne tient pas le seuil de texte : le bleu de marque prend le relais. */
    color: var(--color-brand-blue);
    font-family: var(--font-label-mono);
    font-size: 0.7rem;
  }

  .legal-content {
    min-width: 0;
  }

  .legal-content h2 {
    max-width: 16ch;
    margin-top: 0.6rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
  }

  .legal-content h3 {
    color: var(--color-brand-black);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .legal-content p,
  .legal-content li,
  .legal-content dd {
    line-height: 1.7;
  }

  .legal-content > section > p:not(.legal-section-number),
  .legal-subsection > p {
    max-width: 51rem;
    margin-top: 1.25rem;
    color: rgb(57 54 54 / 72%);
  }

  /* Sur blanc et sur crème, l'orange ne tient pas le seuil de texte : le bleu de marque prend le relais. */
  .legal-section-number {
    color: var(--color-brand-blue);
  }

  .legal-summary {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgb(61 67 206 / 24%);
    background: rgb(61 67 206 / 5%);
  }

  .legal-summary h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .legal-section {
    padding-top: clamp(4rem, 9vw, 7rem);
    scroll-margin-top: 7rem;
  }

  .legal-card-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .legal-card {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid rgb(57 54 54 / 14%);
    background: var(--color-brand-cream);
  }

  .legal-card--accent {
    border-color: var(--color-brand-blue);
    background: var(--color-brand-blue);
    color: white;
  }

  .legal-card--accent h3 {
    color: white;
  }

  .legal-card--accent p {
    color: rgb(255 255 255 / 80%);
  }

  .legal-card--accent a,
  .legal-card--accent button {
    padding: 0;
    border: 0;
    background: none;
    color: white;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .legal-details {
    margin-top: 1.25rem;
  }

  .legal-details div {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0;
    border-top: 1px solid rgb(57 54 54 / 12%);
  }

  .legal-details dt {
    color: rgb(57 54 54 / 72%);
    font-family: var(--font-label-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .legal-details dd {
    margin: 0;
    color: rgb(57 54 54 / 80%);
  }

  .legal-host {
    display: grid;
