---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import EditorialGrid from '../components/EditorialGrid.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EVENT } from '../lib/event';
import { getLocaleFromPath, localizePath } from '../lib/i18n';
import { getLocalizedCollection } from '../lib/localized-content';

const locale = getLocaleFromPath(Astro.url.pathname);

const tierSequence = ['platinum', 'gold', 'silver'] as const;

const partners = (await getLocalizedCollection('partners', locale)).sort((a, b) => a.data.order - b.data.order);
const coOrganizer = partners.find((partner) => partner.data.coOrganizer);
const copy = {
  fr: {
    lede: coOrganizer
      ? `La ${coOrganizer.data.name} soutient cette édition et l’accueille à l’${EVENT.venue.shortName}, aux côtés des entreprises et réseaux engagés.`
      : 'Des organisations engagées pour relier les communautés techniques, les entreprises et le territoire.',
    pageTitle: `Partenaires · GENAI DAYS${coOrganizer ? ` · avec le soutien de la ${coOrganizer.data.name}` : ''}`,
    descriptionIntro: `Partenaires de ${EVENT.name} à ${EVENT.venue.city}.`,
    listName: `Partenaires de ${EVENT.name}`,
    homeLabel: 'Accueil',
    title: 'Partenaires',
    boardTitle: 'Les partenaires de la journée',
    websiteLabel: (name: string) => `Visiter le site de ${name}`,
    logoAlt: (name: string) => `Logo ${name}`,
    invitationTitle: 'Votre organisation veut prendre part à la journée ?',
    invitationText: 'Échangez avec l’équipe sur les formats de partenariat et la manière de contribuer à l’édition.',
    becomePartner: 'Devenir partenaire',
  },
  en: {
    lede: coOrganizer
      ? `The ${coOrganizer.data.name} supports this edition and hosts it at the ${EVENT.venue.shortName}, alongside committed companies and networks.`
      : 'Organizations committed to connecting tech communities, businesses and the region.',
    pageTitle: `Partners · GENAI DAYS${coOrganizer ? ` · with support from the ${coOrganizer.data.name}` : ''}`,
    descriptionIntro: `${EVENT.name} partners in ${EVENT.venue.city}.`,
    listName: `${EVENT.name} partners`,
    homeLabel: 'Home',
    title: 'Partners',
    boardTitle: 'Partners supporting the day',
    websiteLabel: (name: string) => `Visit the ${name} website`,
    logoAlt: (name: string) => `${name} logo`,
    invitationTitle: 'Want your organization to take part in the day?',
    invitationText: 'Talk with the team about partnership options and how you can contribute to this edition.',
    becomePartner: 'Become a partner',
  },
}[locale];

const partnerGroups = tierSequence.map((tier) => {
  const tierPartners = partners
    .filter((partner) => partner.data.tier === tier)
    .map((partner) => {
      const logo = {
        src: partner.data.monochromeLogo ?? partner.data.logo,
        width: partner.data.monochromeLogoWidth ?? partner.data.logoWidth,
        height: partner.data.monochromeLogoHeight ?? partner.data.logoHeight,
      };

      return { partner, logo };
    });
  return {
    tier,
    partners: tierPartners,
  };
}).filter((group) => group.partners.length > 0);

const publishedPartners = partnerGroups.flatMap((group) => group.partners);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = new URL(localizePath('/', locale), siteUrl).href;
const pageUrl = new URL(localizePath('/partenaires', locale), siteUrl).href;
const pageDescription = `${copy.descriptionIntro} ${copy.lede}`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: copy.listName,
    description: pageDescription,
    url: pageUrl,
    inLanguage: locale,
    about: { '@id': `${siteUrl.href}#event` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: publishedPartners.map(({ partner }, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: partner.data.website,
        item: {
          '@type': 'Organization',
          name: partner.data.name,
          url: partner.data.website,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.homeLabel, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: copy.title, item: pageUrl },
    ],
  },
];

---

<BaseLayout
  title={copy.pageTitle}
  description={pageDescription}
  structuredData={structuredData}
>
  <Header />

  <main class="partners-page">
    <section class="partners-hero" aria-labelledby="partners-title">
      <figure class="partners-hero__visual" aria-hidden="true">
        <img
          src="/images/nantes_castle-optimized.webp"
          alt=""
          width="2560"
          height="826"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <span class="partners-hero__shade" aria-hidden="true"></span>
      <EditorialGrid tone="paper" top={false} />

      <div class="partners-hero__inner">
        <h1 id="partners-title" class="type-page-title type-page-title--long">{copy.title}</h1>
        <p>{copy.lede}</p>
      </div>
    </section>

    <section class="partner-wall" aria-labelledby="partner-wall-title">
      <EditorialGrid top={false} />
      <h2 id="partner-wall-title" class="sr-only">{copy.boardTitle}</h2>

      <div class="partner-wall__inner">
        {partnerGroups.map((group) => (
          <ul
            class:list={[
              'partner-wall__group',
              `partner-wall__group--${group.tier}`,
            ]}
          >
            {group.partners.map(({ partner, logo }) => (
              <li
                class:list={[
                  'partner-wall__item',
                  partner.data.coOrganizer && 'partner-wall__item--coorganizer',
                  partner.id === 'leboncoin' && 'partner-wall__item--padded-logo',
                ]}
              >
                <a
                  class="partner-wall__link"
                  href={partner.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={copy.websiteLabel(partner.data.name)}
                  style={`--partner-logo: url("${encodeURI(logo.src)}");`}
                >
                  <img
                    src={logo.src}
                    alt={copy.logoAlt(partner.data.name)}
                    width={logo.width}
                    height={logo.height}
                    loading="eager"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <section id="devenir-partenaire" class="partners-invitation" aria-labelledby="partners-invitation-title">
      <EditorialGrid top={false} />
      <div class="partners-invitation__inner">
        <div>
          <h2 id="partners-invitation-title" class="type-section-title">
            {copy.invitationTitle}
          </h2>
          <p>
            {copy.invitationText}
          </p>
        </div>
        <Button class="partners-invitation__button" variant="secondary" contact="partner">
          {copy.becomePartner}
        </Button>
      </div>
    </section>
  </main>

  <Footer grid />
</BaseLayout>

<style>
  .partners-page {
    position: relative;
    background: var(--color-brand-cream);
    color: var(--color-brand-black);
  }

  .partners-hero,
  .partner-wall,
  .partners-invitation {
    position: relative;
  }

  .partners-hero__inner,
  .partner-wall__inner,
  .partners-invitation__inner {
    position: relative;
    z-index: 3;
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    margin-inline: auto;
  }

  .partners-hero {
    overflow: hidden;
    background: var(--color-brand-night);
    color: var(--color-brand-cream);
    isolation: isolate;
  }

  .partners-hero__visual {
    position: absolute;
    z-index: 0;
    inset: 0;
    margin: 0;
    pointer-events: none;
  }

  .partners-hero__visual img {
    width: 100%;
    height: 100%;
    filter: saturate(0.74) contrast(1.04);
    object-fit: cover;
    object-position: 58% 52%;
  }

  .partners-hero__shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(9 18 46 / 96%) 0%, rgb(9 18 46 / 84%) 38%, rgb(9 18 46 / 34%) 74%),
      linear-gradient(180deg, rgb(9 18 46 / 12%), rgb(9 18 46 / 36%));
    pointer-events: none;
  }

  .partners-hero__inner {
    display: grid;
    min-height: clamp(14rem, 19vw, 17rem);
    align-content: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.75rem);
    gap: 0.65rem;
  }

  .partners-hero h1 {
    max-width: 11ch;
    font-size: 3rem;
  }

  .partners-hero p {
    max-width: 40rem;
    color: rgb(249 244 236 / 84%);
    font-size: 1rem;
    line-height: 1.6;
  }

  .partner-wall {
    padding-block: var(--space-section-compact);
    background: var(--color-brand-cream);
  }

  .partner-wall__inner {
    display: grid;
    padding-inline: clamp(1.25rem, 3vw, 2.75rem);
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .partner-wall__group {
    --partner-height: 4rem;
    --partner-gap: 1.5rem;
    --partner-inset: 0.375rem;
    display: flex;
    width: 100%;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    padding: 0;
    gap: 1.25rem var(--partner-gap);
    list-style: none;
  }

  .partner-wall__group--platinum {
    --partner-height: 6rem;
    --partner-gap: 2rem;
  }

  .partner-wall__group--gold {
    --partner-height: 4.5rem;
    width: 88%;
    max-width: 52rem;
    row-gap: 0.25rem;
  }

  .partner-wall__group--silver {
    --partner-height: 3rem;
    --partner-gap: 1rem;
    max-width: 58rem;
  }

  .partner-wall__item {
    min-width: 0;
    flex: 0 0 calc((100% - var(--partner-gap)) / 2);
  }

  .partner-wall__group--silver .partner-wall__item {
    flex-basis: calc((100% - 2 * var(--partner-gap)) / 3);
  }

  .partner-wall__link {
    position: relative;
    display: grid;
    height: var(--partner-height);
    place-items: center;
    color: inherit;
  }

  .partner-wall__link:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 0.5rem;
  }

  /* L’image porte l’alternative textuelle, le masque unifie l’encre des logos. */
  .partner-wall__link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }

  .partner-wall__link::before {
    position: absolute;
    inset: var(--partner-inset);
    background: var(--color-brand-black);
    content: '';
    -webkit-mask: var(--partner-logo) center / contain no-repeat;
    mask: var(--partner-logo) center / contain no-repeat;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .partner-wall__link:hover::before {
    opacity: 0.65;
  }

  /* Le logo leboncoin est centré dans un carré avec de larges marges transparentes. */
  .partner-wall__item--padded-logo .partner-wall__link::before {
    -webkit-mask-size: min(100%, calc((var(--partner-height) - 2 * var(--partner-inset)) * 800 / 279)) auto;
    mask-size: min(100%, calc((var(--partner-height) - 2 * var(--partner-inset)) * 800 / 279)) auto;
  }

  .partners-invitation {
    border-top: 1px solid rgb(57 54 54 / 18%);
    background: var(--color-brand-cream);
  }

  .partners-invitation__inner {
    display: grid;
    align-items: end;
    padding: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2.75rem);
    border-inline: 1px solid rgb(57 54 54 / 14%);
    gap: 2rem;
  }

  .partners-invitation h2 {
    max-width: 18ch;
  }

  .partners-invitation p {
    max-width: 58ch;
    margin-top: 0.85rem;
    color: rgb(57 54 54 / 72%);
    line-height: 1.6;
  }

  :global(.partners-invitation__button) {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .partner-wall__group--platinum {
      --partner-height: 7rem;
    }

    .partner-wall__group--gold {
      --partner-height: 5rem;
      --partner-gap: 2rem;
    }

    .partner-wall__group--gold .partner-wall__item {
      flex-basis: calc((100% - 2 * var(--partner-gap)) / 3);
    }

    .partner-wall__group--silver .partner-wall__item {
      flex-basis: calc((100% - 4 * var(--partner-gap)) / 5);
    }
  }

  @media (min-width: 52rem) {
    .partners-invitation__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 64rem) {
    .partner-wall__group--platinum {
      --partner-height: 8.5rem;
      --partner-gap: 3rem;
    }

    .partner-wall__group--gold {
      --partner-height: 6rem;
      --partner-gap: 2.5rem;
      width: 72%;
    }

    .partner-wall__group--platinum .partner-wall__item,
    .partner-wall__group--gold .partner-wall__item {
      flex-basis: calc((100% - 3 * var(--partner-gap)) / 4);
    }

    .partner-wall__group--silver {
      --partner-height: 3.5rem;
      --partner-gap: 1.5rem;
      width: 90%;
    }

    .partner-wall__group--silver .partner-wall__item {
      flex-basis: calc((100% - 7 * var(--partner-gap)) / 8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-wall__link::before {
      transition: none;
    }
  }
</style>
