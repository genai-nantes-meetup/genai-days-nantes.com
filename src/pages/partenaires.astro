---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Button from '../components/Button.astro';
import EditorialGrid from '../components/EditorialGrid.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EVENT } from '../lib/event';
import { PARTNER_TIER_CAPACITIES } from '../lib/partners';

const tierSequence = ['platinum', 'gold', 'silver'] as const;
type PartnerTier = (typeof tierSequence)[number];

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const coOrganizer = partners.find((partner) => partner.data.coOrganizer);
const pageLede = coOrganizer
  ? `La ${coOrganizer.data.name} co-organise cette édition à l’${EVENT.venue.shortName}, aux côtés des entreprises et réseaux engagés.`
  : 'Des organisations engagées pour relier les communautés techniques, les entreprises et le territoire.';

const partnerGroups = tierSequence.map((tier) => {
  const tierPartners = partners
    .filter((partner) => partner.data.tier === tier)
    .map((partner) => {
      const logo = {
        src: partner.data.logo,
        width: partner.data.logoWidth,
        height: partner.data.logoHeight,
      };

      return { partner, logo };
    });
  const capacity = PARTNER_TIER_CAPACITIES[tier];
  const placeholderCount = capacity === null ? 8 : Math.max(0, capacity - tierPartners.length);

  return {
    tier,
    partners: tierPartners,
    placeholderCount,
    hasCoOrganizer: tierPartners.some(({ partner }) => partner.data.coOrganizer),
  };
});

const publishedPartners = partnerGroups.flatMap((group) => group.partners);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL('/partenaires', siteUrl).href;
const pageDescription = `Partenaires de ${EVENT.name} à ${EVENT.venue.city}. ${pageLede}`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Partenaires de ${EVENT.name}`,
    description: pageDescription,
    url: pageUrl,
    about: { '@id': `${siteUrl.href}#event` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: publishedPartners.map(({ partner }, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: partner.data.website,
        item: {
          '@type': 'Organization',
          name: partner.data.name,
          url: partner.data.website,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteUrl.href },
      { '@type': 'ListItem', position: 2, name: 'Partenaires', item: pageUrl },
    ],
  },
];

---

<BaseLayout
  title={`Partenaires · ${EVENT.name}${coOrganizer ? ` · avec la ${coOrganizer.data.name}` : ''}`}
  description={pageDescription}
  structuredData={structuredData}
>
  <Header />

  <main class="partners-page">
    <section class="partners-hero" aria-labelledby="partners-title">
      <figure class="partners-hero__visual" aria-hidden="true">
        <img
          src="/images/nantes_castle-optimized.webp"
          alt=""
          width="2560"
          height="826"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <span class="partners-hero__shade" aria-hidden="true"></span>
      <EditorialGrid tone="paper" top={false} />

      <div class="partners-hero__inner">
        <h1 id="partners-title" class="type-page-title type-page-title--long">Partenaires</h1>
        <p>{pageLede}</p>
      </div>
    </section>

    <section class="partner-board" aria-labelledby="partner-board-title">
      <EditorialGrid top={false} />
      <h2 id="partner-board-title" class="sr-only">Partenaires confirmés et emplacements à venir</h2>

      <div class="partner-board__inner">
        {partnerGroups.map((group) => (
          <ul
            class:list={[
              'partner-board__group',
              `partner-board__group--${group.tier}`,
              group.hasCoOrganizer && 'partner-board__group--with-coorganizer',
            ]}
          >
            {group.partners.map(({ partner, logo }) => (
              <li
                class:list={[
                  'partner-tile',
                  `partner-tile--${group.tier}`,
                  partner.data.coOrganizer && 'partner-tile--coorganizer',
                ]}
              >
                <a
                  href={partner.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visiter le site de ${partner.data.name}`}
                >
                  <figure class="partner-tile__card">
                    <div class="partner-tile__logo">
                      <img
                        src={logo.src}
                        alt={`Logo ${partner.data.name}`}
                        width={logo.width}
                        height={logo.height}
                        loading="eager"
                        decoding="async"
                      />
                    </div>
                    <figcaption class="sr-only">{partner.data.name}</figcaption>
                    <ArrowIcon direction="external" class="partner-tile__arrow" />
                  </figure>
                </a>
              </li>
            ))}

            {Array.from({ length: group.placeholderCount }, (_, index) => (
              <li
                class:list={[
                  'partner-tile',
                  'partner-tile--future',
                  `partner-tile--${group.tier}`,
                ]}
                aria-label={`Partenaire à venir ${index + 1} sur ${group.placeholderCount}`}
              >
                <div class="partner-tile__card">
                  <div class="partner-tile__logo partner-tile__placeholder" aria-hidden="true">
                    <span>À venir</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </section>

    <section id="devenir-partenaire" class="partners-invitation" aria-labelledby="partners-invitation-title">
      <EditorialGrid top={false} />
      <div class="partners-invitation__inner">
        <div>
          <h2 id="partners-invitation-title" class="type-section-title">
            Votre organisation veut prendre part à la journée&nbsp;?
          </h2>
          <p>
            Échangez avec l’équipe sur les formats de partenariat et la manière de contribuer à l’édition.
          </p>
        </div>
        <Button class="partners-invitation__button" variant="secondary" contact="partner">
          Devenir partenaire
        </Button>
      </div>
    </section>
  </main>

  <Footer grid />
</BaseLayout>

<style>
  .partners-page {
    position: relative;
    background: var(--color-brand-cream);
    color: var(--color-brand-black);
  }

  .partners-hero,
  .partner-board,
  .partners-invitation {
    position: relative;
  }

  .partners-hero__inner,
  .partner-board__inner,
  .partners-invitation__inner {
    position: relative;
    z-index: 3;
    width: min(calc(100% - 2 * var(--layout-gutter)), var(--layout-editorial));
    margin-inline: auto;
  }

  .partners-hero {
    overflow: hidden;
    background: var(--color-brand-night);
    color: var(--color-brand-cream);
    isolation: isolate;
  }

  .partners-hero__visual {
    position: absolute;
    z-index: 0;
    inset: 0;
    margin: 0;
    pointer-events: none;
  }

  .partners-hero__visual img {
    width: 100%;
    height: 100%;
    filter: saturate(0.74) contrast(1.04);
    object-fit: cover;
    object-position: 58% 52%;
  }

  .partners-hero__shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(9 18 46 / 96%) 0%, rgb(9 18 46 / 84%) 38%, rgb(9 18 46 / 34%) 74%),
      linear-gradient(180deg, rgb(9 18 46 / 12%), rgb(9 18 46 / 36%));
    pointer-events: none;
  }

  .partners-hero__inner {
    display: grid;
    min-height: clamp(14rem, 19vw, 17rem);
    align-content: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.75rem);
    gap: 0.65rem;
  }

  .partners-hero h1 {
    max-width: 11ch;
    font-size: 3rem;
  }

  .partners-hero p {
    max-width: 40rem;
    color: rgb(249 244 236 / 84%);
    font-size: 1rem;
    line-height: 1.6;
  }

  .partner-board {
    padding: var(--space-section-close) 0 clamp(1.5rem, 2vw, 2rem);
    background: var(--color-brand-cream);
  }

  .partner-board__inner {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .partner-board__group {
    display: grid;
    overflow: hidden;
    margin: 0;
    padding: 0;
    border: 1px solid rgb(57 54 54 / 16%);
    background: rgb(57 54 54 / 16%);
    gap: 1px;
    list-style: none;
  }

  .partner-tile {
    min-width: 0;
    background: var(--color-brand-white);
  }

  .partner-tile a {
    display: block;
    height: 100%;
    color: inherit;
  }

  .partner-tile a:focus-visible {
    position: relative;
    z-index: 2;
    outline: 3px solid var(--color-brand-blue);
    outline-offset: -3px;
  }

  .partner-tile__card {
    position: relative;
    display: grid;
    overflow: hidden;
    height: 7rem;
    margin: 0;
    background: var(--color-brand-white);
  }

  .partner-tile__logo {
    display: grid;
    min-height: 0;
    place-items: center;
    padding: clamp(1rem, 2vw, 1.75rem);
    background: var(--color-brand-white);
  }

  .partner-tile__logo img {
    width: auto;
    max-width: 78%;
    height: auto;
    max-height: 5rem;
    filter: grayscale(100%) contrast(1.04);
    object-fit: contain;
    transition: filter 360ms ease, transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.partner-tile__arrow) {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    width: 1rem;
    opacity: 0.42;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .partner-tile a:hover .partner-tile__logo img,
  .partner-tile a:focus-visible .partner-tile__logo img {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.035);
  }

  .partner-tile a:hover :global(.partner-tile__arrow),
  .partner-tile a:focus-visible :global(.partner-tile__arrow) {
    opacity: 1;
    transform: translate(0.12rem, -0.12rem);
  }

  .partner-tile__placeholder {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 38%, rgb(57 54 54 / 5%) 0 17%, transparent 17.4%),
      radial-gradient(ellipse at 50% 92%, rgb(57 54 54 / 4%) 0 36%, transparent 36.4%),
      var(--color-brand-cream-deep);
  }

  .partner-tile__placeholder::after {
    position: absolute;
    inset: 0.75rem;
    border: 1px solid rgb(57 54 54 / 16%);
    content: '';
  }

  .partner-tile__placeholder span {
    position: relative;
    z-index: 1;
    color: rgb(57 54 54 / 48%);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 400;
  }

  .partner-tile--platinum .partner-tile__card {
    height: clamp(10rem, 13vw, 12rem);
  }

  .partner-tile--platinum .partner-tile__logo img {
    max-width: 76%;
    max-height: 6rem;
  }

  .partner-tile--coorganizer .partner-tile__logo img {
    max-width: 82%;
    max-height: 7.5rem;
  }

  .partner-tile--gold .partner-tile__card {
    height: clamp(8rem, 10vw, 9.5rem);
  }

  .partners-invitation {
    border-top: 1px solid rgb(57 54 54 / 18%);
    background: var(--color-brand-cream);
  }

  .partners-invitation__inner {
    display: grid;
    align-items: end;
    padding: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2.75rem);
    border-inline: 1px solid rgb(57 54 54 / 14%);
    gap: 2rem;
  }

  .partners-invitation h2 {
    max-width: 18ch;
  }

  .partners-invitation p {
    max-width: 58ch;
    margin-top: 0.85rem;
    color: rgb(57 54 54 / 72%);
    line-height: 1.6;
  }

  :global(.partners-invitation__button) {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .partner-board__group--platinum {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .partner-board__group--platinum.partner-board__group--with-coorganizer {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .partner-tile--coorganizer {
      grid-column: 1 / -1;
    }

    .partner-board__group--gold {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .partner-board__group--silver {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 52rem) {
    .partners-invitation__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 64rem) {
    .partner-board__group--platinum {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .partner-board__group--platinum.partner-board__group--with-coorganizer {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .partner-tile--coorganizer {
      grid-column: span 2;
    }

    /* Sept colonnes, autant que d'emplacements gold ouverts dans
     * src/lib/partners.ts : le rang tient sur une seule ligne. */
    .partner-board__group--gold {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .partner-board__group--silver {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .partner-tile__logo img,
    :global(.partner-tile__arrow) {
      transition: none;
    }

    .partner-tile a:hover .partner-tile__logo img,
    .partner-tile a:focus-visible .partner-tile__logo img,
    .partner-tile a:hover :global(.partner-tile__arrow),
    .partner-tile a:focus-visible :global(.partner-tile__arrow) {
      transform: none;
    }
  }
</style>
