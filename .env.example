# Resend (https://resend.com) API key used to email sticker-collection reward submissions.
# Required in production. Local development simulates a successful submission when omitted.
RESEND_API_KEY=re_your_api_key

# Verified Resend sender and private recipient used for sticker-collection reward submissions.
STICKER_COLLECTION_FROM_EMAIL=
STICKER_COLLECTION_RECIPIENT=

# Private contact values returned only by the on-demand contact endpoint.
CONTACT_GENERAL=
CONTACT_PARTNER=
CONTACT_PROGRAMME=
CONTACT_PRESS=
CONTACT_PRIVACY=
CONTACT_PUBLICATION=

# PostHog project key. Analytics stays disabled when this value is omitted.
PUBLIC_POSTHOG_KEY=
